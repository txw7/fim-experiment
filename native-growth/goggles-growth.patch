+#!/usr/bin/env sbcl --script
+(require :asdf)
+(defparameter *root* (truename (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
+(asdf:initialize-source-registry `(:source-registry (:directory ,*root*) :inherit-configuration))
+(setf *compile-verbose* nil *compile-print* nil)
+(asdf:load-system "lsip")
+(load (merge-pathnames "scripts/h006_fixture_v1.lisp" *root*))
+(in-package #:lsip)
+(install-shg-growth-algebra-v1)
+(let* ((fixture (h006-make-flow-fixture-v1))
+       (request (list :bundle (getf fixture :bundle) :closure (getf fixture :closure)
+                      :generated (getf fixture :generated)
+                      :expected-snapshot (shg-growth-snapshot-v1 (getf fixture :closure))
+                      :transaction "algebra-growth-1" :operations nil
+                      :symbolic-route-profile :source-target-v1
+                      :selected-member-refs
+                      (semantic-region-selection-v1-selected-member-refs (getf fixture :selection))
+                      :policy (getf fixture :policy)
+                      :source-path (make-semantic-scope-path-v1 :segment-tokens '("algebra" "source"))))
+       (input (shg-growth-algebra-operand-v1 request))
+       (current input) (witnesses nil))
+  (dolist (operator '(:shg-append :shg-nest :shg-enclose))
+    (multiple-value-bind (product plan witness)
+        (compose-semantic-objects-v1 operator (list current))
+      (assert plan) (assert witness)
+      (push witness witnesses)
+      (setf current product)))
+  (assert (= 3 (length witnesses)))
+  (assert (eq :structural-candidate (getf (shg-growth-algebra-state-v1 current) :admission)))
+  (assert (eq :open (getf (shg-growth-algebra-state-v1 current) :behavioral-proof)))
+  (assert (h006-rejects-p (lambda () (compose-semantic-objects-v1 :shg-nest (list input)))))
+  (assert (h006-rejects-p (lambda () (compose-semantic-objects-v1 :shg-append (list input input)))))
+  (assert (h006-rejects-p
+           (lambda () (compose-semantic-objects-v1 :shg-append (list input) :parameters '(:unknown t)))))
+  (with-open-file (out (or (uiop:getenv "SHG_ALGEBRA_EVIDENCE") "/tmp/shg-growth-algebra.sexp")
+                       :direction :output :if-exists :supersede)
+    (let ((*print-circle* t) (*print-readably* t))
+      (write (list :witnesses (nreverse witnesses)
+                   :state (shg-growth-algebra-state-v1 current)) :stream out)))
+  (format t "SHGGrowthAlgebraV1Green operators=3 native-witnesses=3 negative-checks=3 behavioral-proof=OPEN~%"))
