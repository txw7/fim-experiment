index 00000000..193a274e
--- /dev/null
+++ b/scripts/check_shg_vm_growth_v1.lisp
@@ -0,0 +1,97 @@
+#!/usr/bin/env sbcl --script
+(require :asdf)
+(defparameter *vm-growth-root* (truename (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
+;; Reuse the actual generated SH40/SH39 activation and regression, not a mock.
+(let* ((path (merge-pathnames "scripts/check_shg_growth_selfhost_v1.lisp" *vm-growth-root*))
+       (*load-truename* (truename path)) (*load-pathname* path))
+  (with-open-file (in path)
+    (read-line in)
+    (loop for form = (read in nil :eof) until (eq form :eof) do (eval form))))
+(in-package #:lsip)
+(defparameter *vm-growth-seed-v1* (make-shg-vm-call-seed-v1))
+(defparameter *vm-growth-path-v1* (make-semantic-scope-path-v1 :segment-tokens '("vm" "generation-0")))
+(defparameter *vm-growth-request-v1*
+  (append (list :transaction "vm-run-growth-1" :construction-law :shg-vm-run-growth-v1
+                :budget 2 :symbolic-route-profile :relation-incidences-v1
+                :source-path *vm-growth-path-v1*
+                :policy (make-semantic-decomposition-policy-v1)
+                :subject-address (shg-vm-run-body-address-v1 *vm-growth-seed-v1* *vm-growth-path-v1*)
+                :expected-snapshot (shg-growth-snapshot-v1 (getf *vm-growth-seed-v1* :closure)))
+          *vm-growth-seed-v1*))
+(defparameter *vm-growth-description-v1* (shg-growth-constructor-description-v1))
+(defparameter *vm-growth-program-v1*
+  (synthesize-semantic-constructor-program-v1
+   *vm-growth-description-v1* :shg-growth-enclosed '(:shg-growth-source)))
+(defun vm-growth-run-v1 (request)
+  (nth-value 0 (execute-shg-growth-request-v1
+                *vm-growth-program-v1* *vm-growth-description-v1* request)))
+(format t "VM-native-seed-ready functions=13 calls=19~%") (finish-output)
+(defparameter *vm-growth-result-v1* (vm-growth-run-v1 *vm-growth-request-v1*))
+(format t "VM-native-growth-returned~%") (finish-output)
+(let* ((source (getf *vm-growth-seed-v1* :bundle))
+       (result *vm-growth-result-v1*)
+       (replay (vm-growth-run-v1 *vm-growth-request-v1*)))
+  (assert (= 13 (length (recursive-semantic-bundle-base-rows-v1 source :member-registry-v1))))
+  (assert (= 19 (length (recursive-semantic-bundle-base-rows-v1 source :relation-registry-v1))))
+  (dolist (kind *semantic-bundle-base-registry-kinds-v1*)
+    (dolist (row (recursive-semantic-bundle-base-rows-v1 source kind))
+      (assert (find (semantic-registry-row-identity-v1 row)
+                    (recursive-semantic-bundle-base-rows-v1 (getf result :bundle) kind)
+                    :test #'equal :key #'semantic-registry-row-identity-v1))))
+  (assert (equal (shg-growth-snapshot-v1 (getf result :child-closure))
+                 (shg-growth-snapshot-v1 (getf replay :child-closure))))
+  (assert (equal (semantic-contracted-region-view-v1-view-identity (getf result :view))
+                 (semantic-contracted-region-view-v1-view-identity (getf replay :view))))
+  (assert (= 17 (length (recursive-semantic-bundle-base-rows-v1 (getf result :child) :member-registry-v1))))
+  (assert (= 10 (length (recursive-semantic-bundle-base-rows-v1 (getf result :child) :hole-registry-v1))))
+  (dolist (prefix '(:child :parent))
+    (let* ((generated (getf result (ecase prefix (:child :child-generated) (:parent :parent-generated))))
+           (refs (semantic-registry-root-v1-row-refs
+                  (semantic-bundle-generated-root-v1 generated :route-registry-v1)))
+           (expected (mapcar #'semantic-registry-row-identity-v1
+                            (shg-growth-incidence-route-rows-v1 (getf result prefix)))))
+      (assert (plusp (length refs)))
+      (assert (equal refs (semantic-bundle-canonical-set-v1 expected)))))
+  (assert (= 13 (length (recursive-semantic-bundle-base-rows-v1 (getf result :child) :relation-registry-v1))))
+  (assert (eq :open (getf (getf result :vm-growth-receipt) :behavioral-proof)))
+  (let ((fresh (copy-list *vm-growth-request-v1*)))
+    (setf (getf fresh :transaction) "vm-run-growth-2")
+    (let ((other (vm-growth-run-v1 fresh)))
+      (assert (not (equal (getf (getf other :vm-growth-receipt) :namespace)
+                          (getf (getf result :vm-growth-receipt) :namespace))))))
+  (dolist (change '((:expected-snapshot "stale") (:budget -1) (:construction-law :unknown)))
+    (let ((bad (copy-list *vm-growth-request-v1*)))
+      (setf (getf bad (first change)) (second change))
+      (growth-rejects-v1 (lambda () (vm-growth-run-v1 bad)))))
+  (let* ((bad (copy-list *vm-growth-request-v1*))
+         (address (copy-semantic-bundle-row-address-v1 (getf bad :subject-address))))
+    (setf (semantic-bundle-row-address-v1-row-ref address)
+          (semantic-hole-row-v1-hole-row-identity
+           (find (semantic-member-row-v1-member-row-identity (shg-vm-member-v1 source :step))
