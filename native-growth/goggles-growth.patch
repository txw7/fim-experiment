+++ b/scripts/check_shg_growth_selfhost_v1.lisp
@@ -0,0 +1,162 @@
+#!/usr/bin/env sbcl --script
+(require :asdf)
+(defparameter *root* (truename (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
+(asdf:initialize-source-registry `(:source-registry (:directory ,*root*) :inherit-configuration))
+(setf *compile-verbose* nil *compile-print* nil)
+(asdf:load-system "lsip")
+(load (merge-pathnames "scripts/h006_fixture_v1.lisp" *root*))
+(in-package #:lsip)
+
+(defun growth-rejects-v1 (thunk)
+  (unless (handler-case (progn (funcall thunk) nil) (error () t))
+    (error "Expected growth rejection did not occur.")))
+
+(defun growth-activate-constructor-hooks-v1 ()
+  ;; Admit only the two authorities used here through their original V2 gates.
+  ;; Other runtime authorities remain on their existing bootstrap lane.
+  (install-shg-growth-constructor-capabilities-v1)
+  (let ((description (shg-growth-constructor-description-v1)) (evidence nil))
+    (multiple-value-bind (accepted output obligation plan program)
+        (generate-semantic-constructor-synthesizer-sh40-v1
+         (install-semantic-constructor-synthesizer-sh40-generator-v1)
+         :shg-growth-synthesizer)
+      (declare (ignore obligation plan))
+      (let ((parity (semantic-constructor-synthesizer-sh40-parity-witness-v1
+                     program description :shg-growth-enclosed
+                     '(:shg-growth-source) *semantic-constructor-capabilities-v1* nil))
+            (independence (semantic-constructor-synthesizer-sh40-independence-witness-v1
+                           program description :shg-growth-enclosed
+                           '(:shg-growth-source) *semantic-constructor-capabilities-v1* nil)))
+        (push (list :component :constructor-synthesizer
+                    :accepted accepted :output output
+                    :program program :parity parity :independence independence
+                    :activation
+                    (multiple-value-list
+                     (activate-semantic-constructor-synthesizer-sh40-v1
+                      accepted output program parity independence))) evidence)))
+    (format t "generated-SH40-active~%")
+    (multiple-value-bind (accepted output obligation plan program)
+        (generate-semantic-constructor-executor-sh39-v1
+         (install-semantic-constructor-executor-sh39-generator-v1)
+         :shg-growth-executor)
+      (declare (ignore obligation plan))
+      (let* ((sample (synthesize-semantic-constructor-program-v1
+                      description :generator-validated '(:generator-active-p)))
+             (environment '(:generator-active-p t))
+             (parity (semantic-constructor-executor-sh39-parity-witness-v1
+                      program sample description environment))
+             (independence (semantic-constructor-executor-sh39-independence-witness-v1
+                            program sample description environment)))
+        (push (list :component :constructor-executor
+                    :accepted accepted :output output
+                    :program program :parity parity :independence independence
+                    :activation
+                    (multiple-value-list
+                     (activate-semantic-constructor-executor-sh39-v1
+                      accepted output program parity independence))) evidence)))
+    (format t "generated-SH39-active~%")
+    (nreverse evidence)))
+
+(defparameter *growth-self-host-evidence-v1* (growth-activate-constructor-hooks-v1))
+(unless (and (null *semantic-constructor-synthesizer-reference-enabled-p*)
+             (null *semantic-constructor-executor-reference-enabled-p*))
+  (error "Growth is not on generated constructor/executor path."))
+(let* ((fixture (h006-make-flow-fixture-v1))
+       (bundle (getf fixture :bundle)) (closure (getf fixture :closure))
+       (source-id (recursive-semantic-bundle-v1-bundle-identity bundle))
+       (description (shg-growth-constructor-description-v1))
+       (program (synthesize-semantic-constructor-program-v1
+                 description :shg-growth-enclosed '(:shg-growth-source)))
+       (added (make-semantic-member-row-v1
+               :local-member-key :growth-obligation
+               :member-kind :operation :semantic-ref :open-growth-obligation))
+       (request (list :bundle bundle :closure closure :generated (getf fixture :generated)
+                      :expected-snapshot (shg-growth-snapshot-v1 closure)
+                      :transaction "growth-transaction-1"
+                      :symbolic-route-profile :source-target-v1
+                      :operations (list (list :add-member added))
+                      :selected-member-refs
+                      (semantic-region-selection-v1-selected-member-refs
+                       (getf fixture :selection))
+                      :policy (getf fixture :policy)
+                      :source-path (make-semantic-scope-path-v1
+                                    :segment-tokens '("growth" "source"))))
+       (run (lambda (input)
+              (nth-value 0 (execute-shg-growth-request-v1 program description input))))
+       (result (funcall run request))
+       (replay (funcall run request))
+       (fresh-request (copy-list request)))
+  (assert (= 3 (length (semantic-constructor-program-v1-nodes program))))
+  (let* ((routes (semantic-registry-root-v1-row-refs
+                  (semantic-bundle-generated-root-v1
+                   (getf result :generated) :route-registry-v1)))
+         (derived (shg-growth-symbolic-route-rows-v1
+                   (getf result :bundle) :source-target-v1)))
+    (assert (= 2 (length routes)))
+    (assert (equal routes
+                   (semantic-bundle-canonical-set-v1 (mapcar #'semantic-registry-row-identity-v1 derived)))))
+  (growth-rejects-v1
+   (lambda () (shg-growth-symbolic-route-rows-v1 bundle :unknown-profile)))
+  (assert (equal source-id (recursive-semantic-bundle-v1-bundle-identity bundle)))
+  (assert (= 3 (length (recursive-semantic-bundle-base-rows-v1 bundle :member-registry-v1))))
+  (assert (= 4 (length (recursive-semantic-bundle-base-rows-v1
+                        (getf result :bundle) :member-registry-v1))))
+  (assert (equal (semantic-contracted-region-view-v1-view-identity (getf result :view))
+                 (semantic-contracted-region-view-v1-view-identity (getf replay :view))))
+  (setf (getf fresh-request :transaction) "growth-transaction-2")
+  (let ((fresh (funcall run fresh-request)))
+    (assert (not (equal
+                  (semantic-contracted-region-view-v1-embedding-occurrence-ref (getf result :view))
+                  (semantic-contracted-region-view-v1-embedding-occurrence-ref (getf fresh :view))))))
+  (let ((bad (copy-list request)))
+    (setf (getf bad :expected-snapshot) "stale")
+    (growth-rejects-v1 (lambda () (funcall run bad))))
+  (let ((bad (copy-list request)))
+    (setf (getf bad :operations) (list (list :add-member (getf fixture :a))))
+    (growth-rejects-v1 (lambda () (funcall run bad))))
+  (let ((bad (copy-list request)))
+    (setf (getf bad :operations) (list (list :add-member added :unexpected)))
+    (growth-rejects-v1 (lambda () (funcall run bad))))
+  (growth-rejects-v1
+   (lambda ()
+     (synthesize-semantic-constructor-program-v1
+      description :shg-growth-enclosed '(:shg-growth-source)
+      :capabilities (remove :shg-growth-nest-v1
+                            *semantic-constructor-capabilities-v1*
+                            :key #'semantic-constructor-capability-v1-capability-id))))
+  (assert (getf result :child-addresses))
+  (dolist (prefix '(:child :parent))
+    (let* ((generated (getf result (ecase prefix (:child :child-generated) (:parent :parent-generated))))
+           (bundle (getf result prefix))
+           (routes (semantic-registry-root-v1-row-refs
+                    (semantic-bundle-generated-root-v1 generated :route-registry-v1))))
+      (assert (= 1 (length routes)))
+      (assert (equal routes (semantic-bundle-canonical-set-v1
+                            (mapcar #'semantic-registry-row-identity-v1
+                                    (shg-growth-source-target-route-rows-v1 bundle)))))))
+  (growth-rejects-v1
+   (lambda () (semantic-constructor-synthesizer-reference-v1
+               description :shg-growth-enclosed '(:shg-growth-source))))
+  (growth-rejects-v1
+   (lambda () (semantic-constructor-executor-reference-v1
+               program description (list :request request))))
+  (let ((expanded (expand-semantic-region-v1
+                   (getf result :view) :child-bundle (getf result :child)
+                   :child-closure (getf result :child-closure)
+                   :child-generated (getf result :child-generated))))
+    (assert (= 2 (length (semantic-expanded-region-view-v1-member-refs expanded)))))
+  (with-open-file (out (or (uiop:getenv "SHG_GROWTH_EVIDENCE") "/tmp/shg-growth-native.sexp")
+                       :direction :output :if-exists :supersede)
+    (let ((*print-circle* t) (*print-readably* t))
+      (write (list :self-host-evidence *growth-self-host-evidence-v1*
+                   :program (semantic-constructor-program-form-v1 program)
+                   :synthesizer *semantic-constructor-synthesizer-active-component-id*
+                   :executor *semantic-constructor-executor-active-component-id*
+                   :source source-id :result result :replay replay)
+             :stream out)))
+  (format t "synthesizer=~A~%executor=~A~%program=~A~%child-addresses=~D~%"
+          *semantic-constructor-synthesizer-active-component-id*
+          *semantic-constructor-executor-active-component-id*
+          (semantic-constructor-program-v1-program-identity program)
+          (length (getf result :child-addresses)))
+  (format t "SHGGrowthSelfHostV1Green operators=3 source-preserved=1 replay=1 fresh-embedding=1 reference-disabled=1 behavioral-proof=OPEN~%"))
