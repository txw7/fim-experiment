+#!/usr/bin/env sbcl --script
+(require :asdf)
+(defparameter *root* (truename (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
+(asdf:initialize-source-registry `(:source-registry (:directory ,*root*) :inherit-configuration))
+(setf *compile-verbose* nil *compile-print* nil)
+(asdf:load-system "lsip")
+(in-package #:lsip)
+(defparameter *boundary-artifact-v1*
+  (with-open-file (in (or (uiop:getenv "SHG_VM_ARTIFACT") "/home/user0/FIM/runs/native-vm-growth-v1/native.sexp"))
+    (let ((*read-eval* nil)) (read in))))
+(defparameter *boundary-state-v1* (getf *boundary-artifact-v1* :result))
+(let* ((state *boundary-state-v1*) (links (shg-vm-boundary-links-v1 state))
+       (mappings (if (getf state :step-growth-receipt) 6 2)))
+  (assert (= mappings (count "boundary-correspondence" links :test #'equal :key (lambda (e) (cdr (assoc "type" e :test #'equal))))))
+  (assert (= (* 3 mappings) (length links)))
+  (let* ((bad (copy-list state))
+         (map (copy-semantic-extraction-address-map-v1 (getf state :address-map))))
+    (setf (semantic-extraction-address-map-v1-parent-boundary-rewrites map)
+          (copy-tree (semantic-extraction-address-map-v1-parent-boundary-rewrites map))
+          (getf (first (semantic-extraction-address-map-v1-parent-boundary-rewrites map)) :parent-port-ref) "missing"
+          (semantic-extraction-address-map-v1-address-map-identity map)
+          (realization-v1-digest (list :semantic-extraction-address-map-v1 (semantic-extraction-address-map-form-v1 map)))
+          (getf bad :address-map) map)
+    (assert (handler-case (progn (shg-vm-boundary-links-v1 bad) nil) (error () t))))
+  (let ((view (shg-vm-growth-view-v1 state)))
+    (with-open-file (out (or (uiop:getenv "SHG_VM_GROWTH_VIEW") "/tmp/shg-vm-connected.json")
+                         :direction :output :if-exists :supersede)
+      (write-string (compiler-ir-json-value view) out)))
+  (format t "SHGVmBoundaryViewV1Green mappings=~D links=~D dangling-rejected=1 snapshots-unchanged=1~%" mappings (length links)))
