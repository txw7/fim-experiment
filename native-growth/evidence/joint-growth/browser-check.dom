 :REFINEMENT :PARTICIPANT-KIND :MEMBER :PARTICIPANT-REF \"439af92a0c9816a2dd6250ee69342671a516d44b820309065d439963dfd7ca90\" :ORDINAL NIL :CONTRACT-REF NIL :FORMAL-STATE-REF NIL) :CHILD-PORT-REF \"beeb5e26b288b72990524f8f62afcbbd5868ce18c42701086d2bf27c97328702\" :PARENT-PORT-REF \"eec735bf89cb06191f6cf0ea985f014ab6a95b810b75c6978e22e9e1469099ef\" :SUCCESSOR-INCIDENCE-REF \"f316fc7b76478576bdfff992afa531609ae0f818da4a44e0ebe4b5268a9a8b45\") :SOURCE-ADDRESS #S(LSIP::SEMANTIC-BUNDLE-ROW-ADDRESS-V1 :DOMAIN :SEMANTIC :BUNDLE-OCCURRENCE-PATH #S(LSIP::SEMANTIC-SCOPE-PATH-V1 :SEGMENT-TOKENS (\"vm\" \"generation-0\" \"016d3840d3005a0cd6509958241a2ee528edd836d66e3dd4eaca78328e68c3ed\") :SCOPE-IDENTITY \"1c23af34f5eddb569d0f75c0a3bc01b23ab1adcca7dc65e4e0e5cb66f33a3bab\") :BUNDLE-SNAPSHOT-REF \"de33ac595281e5f22989340f61ef796afdb6ebabac1d483e3f08bd4bfd0e31eb\" :REGISTRY-KIND :PORT-REGISTRY-V1 :ROW-REF \"beeb5e26b288b72990524f8f62afcbbd5868ce18c42701086d2bf27c97328702\" :FACET-REF NIL :LINEAGE-REF #S(LSIP::CONSTRUCTION-LINEAGE-REF-V1 :LINEAGE-KEY (:BUNDLE-PATH (\"vm\" \"generation-0\" \"016d3840d3005a0cd6509958241a2ee528edd836d66e3dd4eaca78328e68c3ed\") :REGISTRY-KIND :PORT-REGISTRY-V1 :ROW-REF \"beeb5e26b288b72990524f8f62afcbbd5868ce18c42701086d2bf27c97328702\") :PREDECESSOR-REF NIL :LINEAGE-IDENTITY \"13a36bbc83c615fda4fa7726d7ddebd63bb457af494c05bf2ba66231252e6446\") :ADDRESS-IDENTITY \"09fa3bc32cc02610e8655bdf93f0a87581f05b32447d6267868acfed0c935d26\") :TARGET-ADDRESS #S(LSIP::SEMANTIC-BUNDLE-ROW-ADDRESS-V1 :DOMAIN :SEMANTIC :BUNDLE-OCCURRENCE-PATH #S(LSIP::SEMANTIC-SCOPE-PATH-V1 :SEGMENT-TOKENS (\"vm\" \"generation-0\" \"016d3840d3005a0cd6509958241a2ee528edd836d66e3dd4eaca78328e68c3ed\") :SCOPE-IDENTITY \"1c23af34f5eddb569d0f75c0a3bc01b23ab1adcca7dc65e4e0e5cb66f33a3bab\") :BUNDLE-SNAPSHOT-REF \"de33ac595281e5f22989340f61ef796afdb6ebabac1d483e3f08bd4bfd0e31eb\" :REGISTRY-KIND :MEMBER-REGISTRY-V1 :ROW-REF \"439af92a0c9816a2dd6250ee69342671a516d44b820309065d439963dfd7ca90\" :FACET-REF NIL :LINEAGE-REF #S(LSIP::CONSTRUCTION-LINEAGE-REF-V1 :LINEAGE-KEY (:BUNDLE-PATH (\"vm\" \"generation-0\" \"016d3840d3005a0cd6509958241a2ee528edd836d66e3dd4eaca78328e68c3ed\") :REGISTRY-KIND :MEMBER-REGISTRY-V1 :ROW-REF \"439af92a0c9816a2dd6250ee69342671a516d44b820309065d439963dfd7ca90\") :PREDECESSOR-REF NIL :LINEAGE-IDENTITY \"46826c6a3f0433aa53a3a92184518b7aa8b1cf3e2cd154df53c611240b16b8a2\") :ADDRESS-IDENTITY \"56aac4af44313ae496e5bf25ef7f8b48483ce67d9db952db9f83e87c3cd21f48\"))"}]}</script><script>
const D=JSON.parse(document.getElementById('data').textContent),C=document.getElementById('network'),ctx=C.getContext('2d');
let nodes=[],edges=[],w=0,h=0,scale=1,tx=0,ty=0,drag=null,picked=null;
const R='relation-registry-v1',M='member-registry-v1',P='port-registry-v1';
function build(){const all=document.getElementById('view').value==='all',used=new Set(D.edges.flatMap(e=>[e.source,e.target]));nodes=D.nodes.filter(n=>(n.scope!=='child'||document.getElementById('expand').checked)&&(all||n.registry===M||n.registry===R||(n.registry===P&&used.has(n.id)))).map((m,i)=>({m,x:(m.scope==='parent'?-250:250)+210*Math.cos(i*2.399),y:210*Math.sin(i*2.399)}));const map=new Map(nodes.map(n=>[n.m.id,n]));edges=D.edges.filter(e=>map.has(e.source)&&map.has(e.target));
for(let t=0;t<240;t++){const forces=nodes.map(()=>[0,0]);for(let i=0;i<nodes.length;i++){for(let j=i+1;j<nodes.length;j++){let dx=nodes[i].x-nodes[j].x,dy=nodes[i].y-nodes[j].y,d2=dx*dx+dy*dy+80,k=1200/d2;forces[i][0]+=dx*k;forces[i][1]+=dy*k;forces[j][0]-=dx*k;forces[j][1]-=dy*k;}forces[i][0]+=( (nodes[i].m.scope==='parent'?-250:250)-nodes[i].x)*.006;forces[i][1]+=-nodes[i].y*.006;}for(const e of edges){const a=map.get(e.source),b=map.get(e.target),i=nodes.indexOf(a),j=nodes.indexOf(b),dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy)||1,k=(d-110)*.018/d;forces[i][0]+=dx*k;forces[i][1]+=dy*k;forces[j][0]-=dx*k;forces[j][1]-=dy*k;}nodes.forEach((n,i)=>{n.x+=Math.max(-8,Math.min(8,forces[i][0]));n.y+=Math.max(-8,Math.min(8,forces[i][1]));});}document.getElementById('counts').textContent=`${nodes.length} rows · ${edges.filter(e=>!e.type).length} incidences + ${edges.filter(e=>e.type).length} boundary links · ${D.resolved_addresses} native addresses resolved`;fit();}
function fit(){if(!nodes.length)return;const xs=nodes.map(n=>n.x),ys=nodes.map(n=>n.y),x0=Math.min(...xs)-80,x1=Math.max(...xs)+180,y0=Math.min(...ys)-120,y1=Math.max(...ys)+120;scale=Math.min(w/(x1-x0),h/(y1-y0),1.3);tx=(w-(x0+x1)*scale)/2;ty=(h-(y0+y1)*scale)/2;draw();}
function draw(){ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);ctx.clearRect(0,0,w,h);ctx.translate(tx,ty);ctx.scale(scale,scale);const child=nodes.filter(n=>n.m.scope==='child');if(child.length){const x0=Math.min(...child.map(n=>n.x))-45,x1=Math.max(...child.map(n=>n.x))+80,y0=Math.min(...child.map(n=>n.y))-50,y1=Math.max(...child.map(n=>n.y))+40;ctx.fillStyle='rgba(80,180,150,.035)';ctx.fillRect(x0,y0,x1-x0,y1-y0);ctx.strokeStyle='#467e70';ctx.setLineDash([8/scale,5/scale]);ctx.strokeRect(x0,y0,x1-x0,y1-y0);ctx.setLineDash([]);ctx.font=(12/scale)+'px system-ui';ctx.fillStyle='#80dabf';ctx.fillText('Embedded coordination region · native H006 child',x0+12/scale,y0+20/scale);}const map=new Map(nodes.map(n=>[n.m.id,n])),q=document.getElementById('search').value.toLowerCase();for(const e of edges){const a=map.get(e.source),b=map.get(e.target);ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.strokeStyle=e.type==='boundary-correspondence'?'#ffcb75':e.type?'#80dabf':e.role==='phase'||e.role==='transition'?'#bc8fd3':'#6f98af';ctx.globalAlpha=e.type?.9:.45;ctx.lineWidth=(e.type?2:1)/scale;ctx.stroke();if(scale>.8){ctx.globalAlpha=.7;ctx.fillStyle='#a6bdcd';ctx.font=(10/scale)+'px system-ui';ctx.fillText(e.role,(a.x+b.x)/2,(a.y+b.y)/2);}}ctx.globalAlpha=1;for(const n of nodes){ctx.globalAlpha=!q||JSON.stringify(n.m).toLowerCase().includes(q)?1:.12;ctx.beginPath();if(n.m.registry===R){ctx.moveTo(n.x,n.y-7/scale);ctx.lineTo(n.x+7/scale,n.y);ctx.lineTo(n.x,n.y+7/scale);ctx.lineTo(n.x-7/scale,n.y);ctx.closePath();}else ctx.arc(n.x,n.y,(n.m.registry===P?4:7)/scale,0,Math.PI*2);ctx.fillStyle=n.m.registry===R?'#ca95f0':n.m.registry===P?'#70d3d7':n.m.registry===M?(n.m.scope==='parent'?'#82b8ff':'#80dabf'):'#a6aab2';ctx.fill();if(picked===n.m.id){ctx.lineWidth=3/scale;ctx.strokeStyle='#fff';ctx.stroke();}ctx.fillStyle='#dfedf7';ctx.font=(11/scale)+'px system-ui';let label=n.m.label.replace(/"[a-f0-9]{64}"\s*/g,'');if(n.m.registry===M&&n.m.details.includes(':MEMBER-KIND :CHILD-BUNDLE'))label='embedded coordination region';if(label.length>44)label=label.slice(-40);ctx.fillText(label,n.x+14,n.y+4);}ctx.globalAlpha=1;}
function inspectEdge(e){picked=null;document.getElementById('title').textContent=e.role;document.getElementById('address').textContent=e.correspondence?'H006 correspondence: '+e.correspondence:'Native incidence: '+e.incidence;const {details,...summary}=e;document.getElementById('detail').textContent=JSON.stringify(summary,null,2);document.getElementById('witness').textContent=details||'';draw();}
function inspect(n){document.getElementById('witness').textContent='';picked=n.id;document.getElementById('title').textContent=n.label;document.getElementById('address').textContent=n.address;document.getElementById('detail').textContent=`scope: ${n.scope}\nregistry: ${n.registry}\nrow: ${n.id}\n\n${n.details}`;draw();}
C.onpointerdown=e=>{C.setPointerCapture(e.pointerId);drag={x:e.clientX,y:e.clientY,tx,ty,moved:false};};C.onpointermove=e=>{if(!drag)return;if(Math.hypot(e.clientX-drag.x,e.clientY-drag.y)>3)drag.moved=true;tx=drag.tx+e.clientX-drag.x;ty=drag.ty+e.clientY-drag.y;draw();};C.onpointerup=e=>{if(drag&&!drag.moved){const r=C.getBoundingClientRect(),x=(e.clientX-r.left-tx)/scale,y=(e.clientY-r.top-ty)/scale,n=nodes.find(n=>Math.hypot(n.x-x,n.y-y)<18/scale);if(n)inspect(n.m);else{const map=new Map(nodes.map(n=>[n.m.id,n]));const edge=edges.find(e=>{const a=map.get(e.source),b=map.get(e.target),dx=b.x-a.x,dy=b.y-a.y,t=Math.max(0,Math.min(1,((x-a.x)*dx+(y-a.y)*dy)/(dx*dx+dy*dy||1)));return Math.hypot(x-a.x-t*dx,y-a.y-t*dy)<6/scale;});if(edge)inspectEdge(edge);}}drag=null;};C.onwheel=e=>{e.preventDefault();const r=C.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top,s=Math.max(.05,Math.min(5,scale*Math.exp(-e.deltaY*.001)));tx=x-(x-tx)*s/scale;ty=y-(y-ty)*s/scale;scale=s;draw();};document.getElementById('fit').onclick=fit;document.getElementById('view').onchange=build;document.getElementById('expand').onchange=build;document.getElementById('search').oninput=draw;document.getElementById('headers').onclick=()=>{document.getElementById('title').textContent='Native bundle snapshots';document.getElementById('address').textContent='';document.getElementById('detail').textContent=JSON.stringify(D.headers,null,2);};new ResizeObserver(()=>{w=C.clientWidth;h=C.clientHeight;C.width=w*devicePixelRatio;C.height=h*devicePixelRatio;fit();}).observe(C);build();
try {const e=D.edges.find(e=>e.type==='boundary-correspondence');inspectEdge(e);if(!document.getElementById('detail').textContent.includes(e.correspondence))throw Error('inspector');document.getElementById('expand').click();if(nodes.some(n=>n.m.scope==='child'))throw Error('collapse');document.getElementById('expand').click();if(!nodes.some(n=>n.m.scope==='child'))throw Error('expand');document.documentElement.dataset.check='passed';}catch(e){document.documentElement.dataset.check='failed:'+e.message;}</script></body></html>
