#!/usr/bin/env sbcl --script
(require :asdf)
(defparameter *joint-root* (truename (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
(let* ((path (merge-pathnames "scripts/check_shg_vm_growth_v1.lisp" *joint-root*))
       (*load-truename* (truename path)) (*load-pathname* path))
  (with-open-file (in path)
    (read-line in)
    (loop for form = (read in nil :eof) until (eq form :eof) do (eval form))))
(in-package #:lsip)
(defparameter *joint-request-v1* (copy-list *vm-growth-request-v1*))
(setf (getf *joint-request-v1* :construction-law) :shg-vm-joint-growth-v1
      (getf *joint-request-v1* :transaction) "vm-joint-growth-1"
      (getf *joint-request-v1* :step-subject-address) (shg-vm-step-body-address-v1 *joint-request-v1*))
(defparameter *joint-result-v1* (vm-growth-run-v1 *joint-request-v1*))
(let* ((result *joint-result-v1*) (child (getf result :child))
       (receipt (getf result :step-growth-receipt))
       (replay (vm-growth-run-v1 *joint-request-v1*)))
  (assert (= 36 (length (recursive-semantic-bundle-base-rows-v1 child :member-registry-v1))))
  (assert (= 22 (length (recursive-semantic-bundle-base-rows-v1 child :hole-registry-v1))))
  (assert (= 33 (length (recursive-semantic-bundle-base-rows-v1 child :relation-registry-v1))))
  (assert (= 3 (length (getf receipt :source-calls))))
  (assert (equal (shg-growth-snapshot-v1 (getf result :child-closure))
                 (shg-growth-snapshot-v1 (getf replay :child-closure))))
  (dolist (kind *semantic-bundle-base-registry-kinds-v1*)
    (dolist (row (recursive-semantic-bundle-base-rows-v1 (getf *joint-request-v1* :bundle) kind))
      (assert (find (semantic-registry-row-identity-v1 row)
                    (recursive-semantic-bundle-base-rows-v1 (getf result :bundle) kind)
                    :test #'equal :key #'semantic-registry-row-identity-v1))))
  (let* ((machine (shg-vm-member-v1 child (list (getf receipt :namespace) :step-machine)))
         (descriptor (second (semantic-member-row-v1-semantic-ref machine)))
         (function (eval (afsm-lisp-expansion-form (getf descriptor :kernel) :shape :function))))
    (validate-recursive-afsm-family-descriptor-v1 descriptor)
    (assert (equal descriptor (getf receipt :machine)))
    (assert (eq :decode (funcall function :fetch '(:fetch-ok))))
    (assert (eq :execute (funcall function :decode '(:decode-ok))))
    (assert (eq :done (funcall function :execute '(:execute-ok))))
    (dolist (phase '(:fetch :decode :execute)) (assert (eq :done (funcall function phase '(:trap)))))
    (assert (eq :fetch (funcall function :done '(:new-request)))))
  (let ((bad (copy-list *joint-request-v1*)))
    (setf (getf bad :step-subject-address) (getf bad :subject-address))
    (growth-rejects-v1 (lambda () (vm-growth-run-v1 bad))))
  (let ((fresh (copy-list *joint-request-v1*)))
    (setf (getf fresh :transaction) "vm-joint-growth-2")
    (let ((other (vm-growth-run-v1 fresh)))
      (assert (not (equal (getf (getf other :step-growth-receipt) :namespace) (getf receipt :namespace))))))
  (dolist (scope '(:parent :child))
    (let* ((generated (getf result (if (eq scope :parent) :parent-generated :child-generated)))
           (actual (semantic-registry-root-v1-row-refs (semantic-bundle-generated-root-v1 generated :route-registry-v1)))
           (expected (mapcar #'semantic-registry-row-identity-v1 (shg-growth-incidence-route-rows-v1 (getf result scope)))))
      (assert (equal actual (semantic-bundle-canonical-set-v1 expected)))))
  (assert (= 18 (length (shg-vm-boundary-links-v1 result))))
  (with-open-file (out (or (uiop:getenv "SHG_JOINT_VIEW") "/tmp/shg-joint-view.json") :direction :output :if-exists :supersede)
    (write-string (compiler-ir-json-value (shg-vm-growth-view-v1 result)) out))
  (with-open-file (out (or (uiop:getenv "SHG_JOINT_EVIDENCE") "/tmp/shg-joint.sexp") :direction :output :if-exists :supersede)
    (let ((*print-readably* t) (*print-circle* t))
      (write (list :request *joint-request-v1* :result result :replay replay) :stream out)))
  (format t "SHGVmJointGrowthV1Green source-functions=13 source-calls=19 controllers=2 call-coordinations=4 phases=9 transitions=13 grown-members=36 open-holes=22 boundary-links=18 replay=1 behavioral-proof=OPEN~%"))
