#!/usr/bin/env sbcl --script
(require :asdf)
(defparameter *context-root* (truename (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
(let* ((path (merge-pathnames "scripts/check_shg_growth_selfhost_v1.lisp" *context-root*))
       (*load-truename* (truename path)) (*load-pathname* path))
  (with-open-file (in path) (read-line in)
    (loop for form = (read in nil :eof) until (eq form :eof) do (eval form))))
(in-package #:lsip)
(install-shg-vm-body-candidate-constitution-v1)
(defparameter *context-artifact*
  (with-open-file (in "/home/user0/FIM/experiment/native-growth/evidence/joint-growth/native.sexp")
    (let ((*read-eval* nil)) (read in))))
(defparameter *context-term*
  (with-open-file (in "/home/user0/FIM/runs/vm-context-lift-native-v1/construction-input.sexp")
    (let ((*read-eval* nil)) (read in))))
(defparameter *context-state*
  (let ((result (getf *context-artifact* :result)))
    (list :transaction "typed-context-native-1"
          :bundle (getf result :parent) :closure (getf result :parent-closure)
          :generated (getf result :parent-generated)
          :retained-child-closures (list (getf result :child-closure))
          :retained-child-generated
          (list (cons (semantic-bundle-closure-ref-v1 (getf result :child-closure))
                      (getf result :child-generated)))
          :expected-snapshot (shg-growth-snapshot-v1 (getf result :parent-closure))
          :source-path (getf result :source-path)
          :symbolic-route-profile :relation-incidences-v1
          :policy (make-semantic-decomposition-policy-v1))))
(defparameter *context-description* (shg-growth-constructor-description-v1))
(defparameter *context-program*
  (synthesize-semantic-constructor-program-v1 *context-description* :shg-growth-enclosed '(:shg-growth-source)))
(defun context-run (term &optional (state *context-state*))
  (nth-value 0 (execute-shg-growth-request-v1 *context-program* *context-description*
                (shg-context-lift-grow-v1 state term))))
(defun context-rejects (term category)
  (handler-case (progn (context-run term) (error "Expected rejection was absent."))
    (error (condition) (assert (search category (princ-to-string condition))))))
(format t "Context-native-start~%") (finish-output)
(defparameter *context-result* (context-run *context-term*))
(let* ((result *context-result*) (receipt (getf result :context-lift-receipt))
       (child (getf result :child)) (replay (context-run *context-term*)))
  (assert (= 3 (getf receipt :calls)))
  (assert (= 4 (getf receipt :dataflows)))
  (assert (= 3 (getf receipt :call-interfaces)))
  (assert (= 4 (length (recursive-semantic-bundle-base-rows-v1 child :member-registry-v1))))
  (assert (= 4 (length (recursive-semantic-bundle-base-rows-v1 child :hole-registry-v1))))
  (assert (= 7 (length (recursive-semantic-bundle-base-rows-v1 child :relation-registry-v1))))
  (dolist (relation (recursive-semantic-bundle-base-rows-v1 child :relation-registry-v1))
    (let ((ends (remove (semantic-relation-row-v1-relation-row-identity relation)
                        (recursive-semantic-bundle-base-rows-v1 child :incidence-registry-v1)
                        :test-not #'equal :key #'semantic-incidence-row-v1-relation-ref)))
      (ecase (semantic-relation-row-v1-relation-kind relation)
        (:protocol
         (assert (equal '(:argument :call-use :result)
                        (sort (mapcar #'semantic-incidence-row-v1-role ends) #'string<))))
        (:dataflow
         (let ((ports (mapcar (lambda (end)
                               (find (semantic-incidence-row-v1-participant-ref end)
                                     (recursive-semantic-bundle-base-rows-v1 child :port-registry-v1)
                                     :test #'equal :key #'semantic-port-row-v1-port-row-identity)) ends)))
           (assert (= 2 (length ports)))
           (assert (equal (semantic-port-row-v1-contract-ref (first ports))
                          (semantic-port-row-v1-contract-ref (second ports)))))))))
  (dolist (member (recursive-semantic-bundle-base-rows-v1 (getf *context-state* :bundle) :member-registry-v1))
    (when (eq :child-bundle (semantic-member-row-v1-member-kind member))
      (assert (find (semantic-member-row-v1-member-row-identity member)
                    (recursive-semantic-bundle-base-rows-v1 (getf result :parent) :member-registry-v1)
                    :test #'equal :key #'semantic-member-row-v1-member-row-identity))))
  (assert (equal (shg-growth-snapshot-v1 (getf result :child-closure))
                 (shg-growth-snapshot-v1 (getf replay :child-closure))))
  (dolist (kind *semantic-bundle-base-registry-kinds-v1*)
    (dolist (row (recursive-semantic-bundle-base-rows-v1 (getf *context-state* :bundle) kind))
      (assert (find (semantic-registry-row-identity-v1 row)
                    (recursive-semantic-bundle-base-rows-v1 (getf result :bundle) kind)
                    :test #'equal :key #'semantic-registry-row-identity-v1))))
  (let ((bad (copy-tree *context-term*)))
    (setf (third (second (fourth bad))) "WrongInput")
    (context-rejects bad "Construction interface mismatch"))
  (let ((bad (copy-tree *context-term*)))
    (setf (fifth (second (fourth bad))) "wrong-address")
    (context-rejects bad "Stale or wrong native callee address"))
  (let ((bad (copy-tree *context-term*)))
    (setf (fourth bad) '(:variable "unbound" "VmState"))
    (context-rejects bad "Unbound or mistyped construction variable"))
  (let ((bad (copy-list *context-state*)))
    (setf (getf bad :retained-child-closures) nil)
    (handler-case (progn (context-run *context-term* bad) (error "Missing child accepted."))
      (error (condition) (assert (search "unavailable closure" (princ-to-string condition))))))
  (dolist (scope '(:parent :child))
    (let* ((generated (getf result (if (eq scope :parent) :parent-generated :child-generated)))
           (actual (semantic-registry-root-v1-row-refs
                    (semantic-bundle-generated-root-v1 generated :route-registry-v1)))
           (expected (mapcar #'semantic-registry-row-identity-v1
                            (shg-growth-incidence-route-rows-v1 (getf result scope)))))
      (assert (equal actual (semantic-bundle-canonical-set-v1 expected)))))
  (with-open-file (out (uiop:getenv "SHG_CONTEXT_VIEW") :direction :output :if-exists :supersede)
    (write-string (compiler-ir-json-value (shg-vm-growth-view-v1 result)) out))
  (with-open-file (out (uiop:getenv "SHG_CONTEXT_EVIDENCE") :direction :output :if-exists :supersede)
    (let ((*print-readably* t) (*print-circle* t))
      (write (list :term *context-term* :source *context-state* :result result :replay replay) :stream out)))
  (format t "SHGContextLiftV1Green calls=3 dataflows=4 members=4 holes=4 replay=1 negative-checks=4 proof=OPEN~%"))
