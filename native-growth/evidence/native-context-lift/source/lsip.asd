(asdf:defsystem "lsip"
  :depends-on ("lsip-compiler-description" "lsip-scaffold-persistence"
               "lsip-graph-addressed-read" "lsip-goggles-reactor-minimal-v1")
  :serial t
  ;; The minimal dependency installs V2 relations before this system registers
  ;; its algebra materializers. Bind built-ins to the final registry only after
  ;; every full-system component has loaded, without dropping custom relations.
  :perform (asdf:load-op :after (operation component)
             (declare (ignore operation component))
             (uiop:symbol-call :lsip :install-semantic-relation-constitutions-v2
                               :preserve-custom-p t))
