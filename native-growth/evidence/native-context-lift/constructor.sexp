   :PROGRAM
   (:SCHEMA :SEMANTIC-CONSTRUCTOR-SYNTHESIZER-PROGRAM-V1 :VERSION 2
    :COMPONENT-ID "semantic-constructor-synthesizer-sh40-v1" :PREDECESSOR-REF
    "semantic-constructor-synthesizer-reference-v1" :INPUT-KIND
    :CONSTRUCTOR-DESCRIPTION-TARGET-FACTS-CAPABILITIES :OUTPUT-KIND
    :SEMANTIC-CONSTRUCTOR-PROGRAM-V1 :AUTHORITY-LAW
    (:VALIDATE-SYNTHESIS-REQUEST :SELECT-MINIMUM-COST-CAPABILITY
     :IDENTITY-TIEBREAK :DEPENDENCY-CLOSURE :CYCLE-REJECTION
     :DETERMINISTIC-NODE-ORDER :EXACT-PROGRAM-CONSTRUCTION
     :NO-PREDECESSOR-DELEGATION)
    :LOWERING-REF "synthesis-self-host-common-lisp-lowering-v1"
    :EXECUTABLE-FORM
    (LAMBDA (DESCRIPTION TARGET-FACT AVAILABLE-FACTS CAPABILITIES CONTEXT)
      (UNLESS
          (AND (TYPEP DESCRIPTION 'SEMANTIC-CONSTRUCTOR-DESCRIPTION-V1)
               (KEYWORDP TARGET-FACT)
               (REALIZATION-V1-PROPER-LIST-P AVAILABLE-FACTS)
               (EVERY #'KEYWORDP AVAILABLE-FACTS)
               (REALIZATION-V1-PROPER-LIST-P CAPABILITIES)
               (EVERY
                (LAMBDA (CAPABILITY)
                  (TYPEP CAPABILITY 'SEMANTIC-CONSTRUCTOR-CAPABILITY-V1))
                CAPABILITIES)
               (REALIZATION-V1-DATA-P CONTEXT))
        (ERROR "Invalid semantic constructor synthesis request."))
      (LET ((SELECTED NIL) (VISITING NIL))
        (LABELS ((CAPABILITY-FOR-FACT (FACT)
                   (NTH-VALUE 0
                              (SELECT-SEMANTIC-CONSTRUCTOR-CAPABILITY-VIA-H001-V1
                               DESCRIPTION FACT CAPABILITIES)))
                 (SELECT-FACT (FACT)
                   (UNLESS (MEMBER FACT AVAILABLE-FACTS :TEST #'EQ)
                     (WHEN (MEMBER FACT VISITING :TEST #'EQ)
                       (ERROR "Cyclic constructor capability dependency: ~S"
                              FACT))
                     (UNLESS
                         (FIND FACT SELECTED :KEY
                               #'SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-PROVIDES
                               :TEST #'EQ)
                       (LET ((CAPABILITY (CAPABILITY-FOR-FACT FACT)))
                         (PUSH FACT VISITING)
                         (DOLIST
                             (REQUIRED
                              (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-REQUIRES
                               CAPABILITY))
                           (SELECT-FACT REQUIRED))
                         (SETF VISITING (REMOVE FACT VISITING :TEST #'EQ))
                         (PUSH CAPABILITY SELECTED))))))
          (SELECT-FACT TARGET-FACT))
        (LET* ((ORDERED (NREVERSE SELECTED))
               (NODE-FOR-FACT
                (MAPCAR
                 (LAMBDA (CAPABILITY)
                   (CONS
                    (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-PROVIDES CAPABILITY)
                    (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-CAPABILITY-ID
                     CAPABILITY)))
                 ORDERED))
               (NODES
                (MAPCAR
                 (LAMBDA (CAPABILITY)
                   (LIST :NODE
                         (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-CAPABILITY-ID
                          CAPABILITY)
                         :PRIMITIVE
                         (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-PRIMITIVE-ID
                          CAPABILITY)
                         :PRIMITIVE-IDENTITY
                         (SEMANTIC-CONSTRUCTOR-PRIMITIVE-DESCRIPTION-V1-DESCRIPTION-IDENTITY
                          (CDR
                           (ASSOC
                            (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-PRIMITIVE-ID
                             CAPABILITY)
                            *SEMANTIC-CONSTRUCTOR-PRIMITIVE-DESCRIPTIONS-V1*
                            :TEST #'EQUAL)))
                         :CAPABILITY-REF
                         (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-CAPABILITY-IDENTITY
                          CAPABILITY)
                         :PROVIDES
                         (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-PROVIDES
                          CAPABILITY)
                         :REQUIRES
                         (COPY-LIST
                          (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-REQUIRES
                           CAPABILITY))
                         :CONTEXT
                         (APPEND (COPY-TREE CONTEXT)
                                 (LIST :AVAILABLE-FACTS
                                       (COPY-LIST AVAILABLE-FACTS)))))
                 ORDERED))
               (RELATIONS
                (LOOP FOR CAPABILITY IN ORDERED
                      APPEND (LOOP FOR REQUIRED IN (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-REQUIRES
                                                    CAPABILITY)
                                   FOR PREDECESSOR = (CDR
                                                      (ASSOC REQUIRED
                                                             NODE-FOR-FACT
                                                             :TEST #'EQ))
                                   WHEN PREDECESSOR
                                   COLLECT (LIST PREDECESSOR
                                                 (SEMANTIC-CONSTRUCTOR-CAPABILITY-V1-CAPABILITY-ID
                                                  CAPABILITY)))))
               (RESULT-NODE
                (OR (CDR (ASSOC TARGET-FACT NODE-FOR-FACT :TEST #'EQ))
                    (ERROR
                     "Constructor target resolved without an executable node."))))
          (MAKE-SEMANTIC-CONSTRUCTOR-PROGRAM-V1 :DESCRIPTION DESCRIPTION :NODES
                                                NODES :RELATIONS RELATIONS
                                                :RESULT-NODE RESULT-NODE)))))
