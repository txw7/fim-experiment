;;; Bounded handwritten SHG extension. H001/H002 remain native owners.
(require :asdf)
(defparameter cl-user::*shg-directory* (uiop:pathname-directory-pathname *load-truename*))
;; Reuse the existing loader/helpers, without running its CLI.
(with-open-file (s (merge-pathnames "synthesis/working_graph.lisp" (uiop:pathname-directory-pathname *load-truename*)))
 (loop for form = (read s nil :end) until (eq form :end) do
  (when (and (consp form) (eq (first form) 'let*)
             (search "COMMAND-LINE-ARGUMENTS" (write-to-string form))) (return))
  (eval form)))
(in-package #:lsip)
(load (merge-pathnames "lisp/semantic_bundle_route_query_v1.lisp" cl-user::*mc-root*))

(minimum-core-install-dependency-constitution-v1)

(defparameter *shg-shapes*
 '((:types id schema refinements)
   (:effects id input output constraints)
   (:contracts id assume guarantee invariants effects dependencies)
   (:ports id owner direction value-type effects contract)
   (:node-types id ports operations machine contract)
   (:occurrences id type parent generation state memory provider body)
   (:relations id type ends contract effects handler)
   (:machines id states initial transitions)
   (:operations id boundary preconditions postconditions effects body contract)
   (:memory id slots)
   (:holes id boundary obligations)
   (:addresses id root generation path member)
   (:bindings id provider capability realization contract)
   (:evidence id kind subject generation digest claim method status evidence)
   (:history id predecessor successor rule delta verification admission)))
;; Explicit extension record types and field codecs, not an opaque JSON blob.
(dolist (shape *shg-shapes*)
 (eval `(defstruct ,(intern (format nil "SHG-~A" (first shape))) ,@(rest shape))))
(defstruct semantic-hypergraph-v1
 id version generation root universe transformations projections invariants lifecycle
 envelope addresses routes checks relation-map proof-subjects)
(defun shg-record (kind &rest fields)
 (let* ((shape (or (assoc kind *shg-shapes*) (error "Unsupported SHG collection ~S" kind)))
        (allowed (mapcar (lambda (x) (intern (symbol-name x) :keyword)) (rest shape))))
  (loop for (key value) on fields by #'cddr do
   (unless (member key allowed) (error "Unsupported field ~S" key)))
  (apply (symbol-function (intern (format nil "MAKE-SHG-~A" kind))) fields)))
(defun shg-form (kind record)
 (cons kind (loop for slot in (rest (assoc kind *shg-shapes*)) append
  (list (intern (symbol-name slot) :keyword) (slot-value record slot)))))
(defun shg-id (r) (slot-value r 'id))
(defun shg-items (g kind) (cdr (assoc kind (semantic-hypergraph-v1-universe g))))
(defun shg-find (g kind id)
 (or (find id (shg-items g kind) :key #'shg-id :test #'equal)
     (error "Missing ~S reference ~S" kind id)))
(define-condition shg-error (error)
 ((category :initarg :category :reader shg-error-category)
  (detail :initarg :detail :reader shg-error-detail))
 (:report (lambda(c s)(format s "SHG ~A: ~A" (shg-error-category c) (shg-error-detail c)))))
(defun shg-fail (category detail) (error 'shg-error :category category :detail detail))
(defun shg-require (test category detail) (unless test (shg-fail category detail)))
(defun shg-header (g)
 (list :semantic-hypergraph (semantic-hypergraph-v1-id g)
  :version (semantic-hypergraph-v1-version g) :generation (semantic-hypergraph-v1-generation g)
  :root (semantic-hypergraph-v1-root g) :collections (mapcar #'car *shg-shapes*)
  :transformations (semantic-hypergraph-v1-transformations g)
  :projections (semantic-hypergraph-v1-projections g) :invariants (semantic-hypergraph-v1-invariants g)
  :lifecycle (semantic-hypergraph-v1-lifecycle g)))
(defun shg-validate (g)
 (unless (and (equal (semantic-hypergraph-v1-version g) '(0 1))
              (integerp (semantic-hypergraph-v1-generation g))
              (>= (semantic-hypergraph-v1-generation g) 0)
              (equal (mapcar #'car (semantic-hypergraph-v1-universe g)) (mapcar #'car *shg-shapes*)))
  (error "SHG header/collection mismatch"))
 (shg-require (= 0 (semantic-hypergraph-v1-generation g)) :unsupported-profile "Only generation zero is supported")
 (shg-require (eq :instantiated (semantic-hypergraph-v1-lifecycle g)) :lifecycle "Read-only structural profile cannot admit or execute")
 (shg-require (null (shg-items g :history)) :unsupported-profile "Revision history is not implemented")
 (let ((ids nil))
  (dolist (collection (semantic-hypergraph-v1-universe g))
   (dolist (r (cdr collection))
    (unless (typep r (intern (format nil "SHG-~A" (car collection)))) (error "Wrong record type"))
    (when (member (shg-id r) ids :test #'equal) (error "Duplicate object identity"))
    (push (shg-id r) ids))))
 (dolist (ty (shg-items g :types))
  (shg-require (and (consp (shg-types-schema ty)) (eq :nominal (first (shg-types-schema ty))) (= 2 (length (shg-types-schema ty)))) :unsupported-profile "Only nominal schemas have a structural type checker"))
 (dolist (e (shg-items g :effects))
  (shg-find g :types (shg-effects-input e)) (shg-find g :types (shg-effects-output e)))
 (dolist (c (shg-items g :contracts))
  (dolist (e (shg-contracts-effects c)) (shg-find g :effects e))
  (dolist (d (shg-contracts-dependencies c)) (shg-find g :contracts d)))
 (dolist (p (shg-items g :ports))
  (unless (member (shg-ports-direction p) '(:in :out :inout)) (error "Invalid direction"))
  (let* ((owner (shg-find g :occurrences (shg-ports-owner p)))
         (node (shg-find g :node-types (shg-occurrences-type owner))))
   (shg-require (member (shg-id p) (shg-node-types-ports node)) :boundary "Port is not declared by owner node type"))
  (shg-find g :types (shg-ports-value-type p)) (shg-find g :contracts (shg-ports-contract p))
  (dolist (e (shg-ports-effects p)) (shg-find g :effects e))
  (shg-require (subsetp (shg-ports-effects p) (shg-contracts-effects (shg-find g :contracts (shg-ports-contract p)))) :effect "Port effect outside contract"))
 (dolist (n (shg-items g :node-types))
  ;; ponytail: singleton node-type instantiation; shared definitions need separate port-instance records.
  (shg-require (= 1 (count (shg-id n) (shg-items g :occurrences) :key #'shg-occurrences-type)) :unsupported-profile "Shared node types need definition-to-instance correspondence")
  (dolist (p (shg-node-types-ports n)) (shg-find g :ports p))
  (dolist (o (shg-node-types-operations n)) (shg-find g :operations o))
  (shg-find g :machines (shg-node-types-machine n)) (shg-find g :contracts (shg-node-types-contract n)))
 (dolist (o (shg-items g :occurrences))
  (shg-find g :node-types (shg-occurrences-type o))
  (unless (= (shg-occurrences-generation o) (semantic-hypergraph-v1-generation g)) (error "Stale occurrence"))
  (unless (eq :none (shg-occurrences-parent o)) (shg-find g :occurrences (shg-occurrences-parent o)))
  (unless (eq :unbound (shg-occurrences-memory o)) (shg-find g :memory (shg-occurrences-memory o)))
  (unless (eq :unbound (shg-occurrences-provider o)) (shg-find g :bindings (shg-occurrences-provider o)))
  (shg-require (member (shg-occurrences-state o)
    (shg-machines-states (shg-find g :machines (shg-node-types-machine (shg-find g :node-types (shg-occurrences-type o)))))) :state "Occurrence state is outside its machine")
  (let ((seen nil) (cursor o))
   (loop do (shg-require (not (member (shg-id cursor) seen)) :containment "Parent cycle")
    (push (shg-id cursor) seen)
    (when (eq :none (shg-occurrences-parent cursor)) (return))
    (setf cursor (shg-find g :occurrences (shg-occurrences-parent cursor)))))
  (shg-require (find (shg-occurrences-body o) (shg-items g :holes) :key #'shg-id) :unsupported-profile "Only addressed hole bodies are supported")
  (shg-require (some (lambda(id)(equal (shg-occurrences-body o) (shg-operations-body (shg-find g :operations id))))
    (shg-node-types-operations (shg-find g :node-types (shg-occurrences-type o)))) :boundary "Occurrence body has no operation owner")
  (shg-find g :holes (shg-occurrences-body o)))
 (dolist (o (shg-items g :operations))
  (shg-find g :contracts (shg-operations-contract o))
  (shg-require (find (shg-operations-body o) (shg-items g :holes) :key #'shg-id) :unsupported-profile "Only addressed hole bodies are supported")
  (dolist (e (shg-operations-effects o))
   (shg-find g :effects e)
   (shg-require (member e (shg-contracts-effects (shg-find g :contracts (shg-operations-contract o)))) :effect "Operation effect outside contract"))
  (shg-require (equal (shg-holes-boundary (shg-find g :holes (shg-operations-body o))) (shg-operations-contract o)) :boundary "Hole/operation contract mismatch")
  (shg-find g :holes (shg-operations-body o))
  (dolist (p (append (getf (shg-operations-boundary o) :inputs) (getf (shg-operations-boundary o) :outputs)))
   (let ((port (shg-find g :ports p)))
    (shg-require (eq (shg-ports-direction port) (if (member p (getf (shg-operations-boundary o) :inputs)) :in :out)) :boundary "Operation boundary direction mismatch"))))
 (dolist (h (shg-items g :holes))
  (shg-find g :contracts (shg-holes-boundary h))
  (dolist (o (shg-holes-obligations h)) (shg-find g :evidence o)))
 (dolist (r (shg-items g :relations))
  (unless (eq (shg-relations-type r) :dataflow) (error "Unsupported relation profile"))
  (shg-find g :contracts (shg-relations-contract r))
  (dolist (e (shg-relations-effects r))
   (shg-require (find e (shg-items g :effects) :key #'shg-id) :effect "Undeclared relation effect"))
  (shg-require (eq :unbound (shg-relations-handler r)) :unsupported-profile "Executable handlers are unsupported")
  (let ((ports (mapcar (lambda(end)(shg-find g :ports (third end))) (shg-relations-ends r))))
   (shg-require (and (= 2 (length ports)) (equal (shg-ports-value-type (first ports)) (shg-ports-value-type (second ports)))
    (equal (shg-ports-contract (first ports)) (shg-relations-contract r))
    (equal (shg-ports-contract (second ports)) (shg-relations-contract r))
    (every (lambda(p)(subsetp (shg-relations-effects r) (shg-ports-effects p))) ports)) :type "Dataflow boundary type/contract/effects mismatch"))
  (unless (equal (mapcar #'first (shg-relations-ends r)) '(:source :target)) (error "Invalid relation roles"))
  (dolist (end (shg-relations-ends r))
   (let ((port (shg-find g :ports (third end))))
    (unless (and (equal (shg-ports-owner port) (second end))
                 (eq (shg-ports-direction port) (if (eq (first end) :source) :out :in)))
     (error "Invalid relation endpoint")))))
 (dolist (m (shg-items g :machines))
  (unless (member (shg-machines-initial m) (shg-machines-states m)) (error "Invalid initial state"))
  (dolist (tr (shg-machines-transitions m))
   (unless (and (member (getf tr :from) (shg-machines-states m))
                (member (getf tr :to) (shg-machines-states m))) (error "Invalid transition"))
   (shg-find g :operations (getf tr :operation)) (shg-find g :contracts (getf tr :contract))
   (shg-require (subsetp (getf tr :effects) (shg-operations-effects (shg-find g :operations (getf tr :operation)))) :effect "Transition effect outside operation")))
 (dolist (m (shg-items g :memory))
  (dolist (s (shg-memory-slots m)) (shg-find g :types (getf s :type))
   (shg-require (eq :uninitialized (getf s :value)) :unsupported-profile "Initialized values need a type checker")))
 (dolist (b (shg-items g :bindings)) (shg-find g :contracts (shg-bindings-contract b))
  (shg-require (every (lambda(x)(eq x :unbound)) (list (shg-bindings-provider b) (shg-bindings-capability b) (shg-bindings-realization b))) :unsupported-profile "Provider execution is unsupported"))
 (dolist (a (shg-items g :addresses))
  (unless (and (eq (shg-addresses-root a) (semantic-hypergraph-v1-id g))
               (= (shg-addresses-generation a) (semantic-hypergraph-v1-generation g))) (error "Stale semantic address")))
 (dolist (e (shg-items g :evidence))
  (shg-find g :addresses (shg-evidence-subject e))
  (unless (= (shg-evidence-generation e) (semantic-hypergraph-v1-generation g)) (error "Stale evidence"))
  (unless (member (shg-evidence-status e) '(:open :proven :refuted :unknown)) (error "Invalid proof status"))
  (shg-require (member (shg-evidence-status e) '(:open :unknown)) :proof "No verified artifact backend in this profile")
  (shg-require (eq :obligation (shg-evidence-kind e)) :unsupported-profile "Evidence artifact admission is unsupported"))
 t)

(defun shg-fixture ()
 (let ((g (make-semantic-hypergraph-v1 :id :g :version '(0 1) :generation 0 :root '/g :lifecycle :instantiated
  :universe (mapcar (lambda (s) (list (car s))) *shg-shapes*)
  :transformations
  '((:instantiate :requires (:valid-node-type :lawful-placement) :produces (:distinct-occurrence :declared-ports))
    (:open-body :requires (:declared-operation-boundary) :produces (:typed-hole :refinement-obligations))
    (:nest :requires (:compatible-child-boundary) :produces (:parent-child-correspondence))
    (:relate :requires (:valid-relation-constitution) :produces (:relation :role-bearing-incidences))
    (:derive-dependency :requires (:referenced-contract-or-type) :produces (:dependency-relation))
    (:refine :requires (:boundary-preservation :state-effect-preservation :behavioral-refinement) :produces (:successor-body :proof-obligations))
    (:revise :requires (:identified-generation :explicit-graph-delta) :produces (:successor-generation :revision-record))
    (:admit :requires (:verified-obligations :valid-contracts :consistent-addresses) :produces (:admitted-generation)))
  :projections '((:structural :occurrences :ports :relations :addresses)
    (:operational :machines :operations :effects :memory) (:dependency :contracts :dependency-relations)
    (:verification :invariants :obligations :evidence) (:synthesis :operations :machines :bindings :target :stack-synth)
    (:routing :bindings :addresses :contracts :target :route-registry) (:evolution :transformations :revisions :history))
  :invariants '(:unique-occurrence-identities :well-typed-port-incidences :well-formed-role-assignments
    :valid-parent-child-boundaries :stable-generation-addressing :declared-effects-only
    :transition-contract-consistency :refinement-preserves-external-contract :admission-requires-verification))))
  (flet ((add (k &rest f) (push (apply #'shg-record k f) (cdr (assoc k (semantic-hypergraph-v1-universe g))))))
   (add :types :id :t :schema '(:nominal :message-v1) :refinements nil)
   (add :effects :id :e :input :t :output :t :constraints '(:declared-only))
   (add :contracts :id :c :assume '(:typed-input) :guarantee '(:typed-output) :invariants '(:boundary-preserved) :effects '(:e) :dependencies nil)
   (add :node-types :id :n :ports '(:p-in :p-out) :operations '(:op) :machine :m :contract :c)
   (add :occurrences :id :instance :type :n :parent :none :generation 0 :state :idle :memory :mem :provider :binding :body :h)
   (add :ports :id :p-in :owner :instance :direction :in :value-type :t :effects '(:e) :contract :c)
   (add :ports :id :p-out :owner :instance :direction :out :value-type :t :effects '(:e) :contract :c)
   (add :operations :id :op :boundary '(:inputs (:p-in) :outputs (:p-out)) :preconditions '(:typed-input) :postconditions '(:typed-output) :effects '(:e) :body :h :contract :c)
   (add :machines :id :m :states '(:idle :done) :initial :idle :transitions '((:id :advance :from :idle :to :done :trigger :message-v1 :guard :typed-input :operation :op :effects (:e) :contract :c)))
   (add :memory :id :mem :slots '((:id :slot :type :t :value :uninitialized)))
   (add :holes :id :h :boundary :c :obligations '(:proof))
   (add :addresses :id :op-address :root :g :generation 0 :path '(:g) :member :op)
   (add :bindings :id :binding :provider :unbound :capability :unbound :realization :unbound :contract :c)
   (add :evidence :id :proof :kind :obligation :subject :op-address :generation 0 :claim :implementation-refines-contract :method :unbound :status :open :evidence nil))
  (push (shg-record :relations :id :r :type :dataflow :ends '((:source :instance :p-out) (:target :instance :p-in)) :contract :c :effects '(:e) :handler :unbound) (cdr (assoc :relations (semantic-hypergraph-v1-universe g))))
  (shg-validate g) g))
(defun shg-root (kind rows)
 (make-semantic-registry-root-v1 :registry-kind kind :rows rows :generation-law-ref :hand-shg-v1))
(defun shg-close (b &optional route-rows)
 (multiple-value-bind (c r) (close-recursive-semantic-bundle-v1 b :route-rows route-rows)
  (semantic-bundle-persistence-envelope-v1 b r c)))
(defun shg-base-rows (g kind)
 (recursive-semantic-bundle-base-rows-v1 (getf (semantic-hypergraph-v1-envelope g) :bundle) kind))
(defun shg-member (g key)
 (or (find key (shg-base-rows g :member-registry-v1) :key #'semantic-member-row-v1-local-member-key :test #'equal)
     (shg-fail :missing "Unknown semantic member")))
(defun shg-port (g key)
 (or (find key (shg-base-rows g :port-registry-v1) :key #'semantic-port-row-v1-local-port-key :test #'equal)
     (shg-fail :missing "Unknown port")))
(defun shg-dependency-intents (g)
 (append
  (loop for e in (shg-items g :effects) append
   (list (list (shg-effects-input e) (shg-id e) :effect-input-type)
         (list (shg-effects-output e) (shg-id e) :effect-output-type)))
  (loop for p in (shg-items g :ports) append
   (cons (list (shg-ports-value-type p) (shg-id p) :port-value-type)
    (mapcar (lambda(e)(list e (shg-id p) :port-effect)) (shg-ports-effects p))))))
(defun shg-native-build (g)
 (with-semantic-boundary-surface-context-v1
 (shg-validate g)
 (shg-require (null (semantic-hypergraph-v1-envelope g)) :unsupported-profile "Rebuild from declarations, not a persisted product")
 (let* ((records (loop for (kind . rows) in (semantic-hypergraph-v1-universe g) append
                   (mapcar (lambda(r)(cons kind r)) rows)))
        (members (cons (make-semantic-member-row-v1 :local-member-key (semantic-hypergraph-v1-root g) :member-kind :semantic-object :semantic-ref (shg-header g))
          (mapcar (lambda(entry)(make-semantic-member-row-v1 :local-member-key (shg-id (cdr entry)) :member-kind (if (eq (car entry) :operations) :operation :semantic-object) :semantic-ref (shg-form (car entry) (cdr entry)))) records)))
        (ports (mapcar (lambda(p)(make-semantic-port-row-v1 :local-port-key (shg-id p) :owner-kind :member
          :owner-ref (semantic-member-row-v1-member-row-identity (find (shg-ports-owner p) members :key #'semantic-member-row-v1-local-member-key))
          :port-kind :data :direction (shg-ports-direction p) :contract-ref (shg-ports-contract p) :surface-ref (shg-ports-value-type p)
          :effect-profile-ref (shg-ports-effects p) :visibility :bundle-export)) (shg-items g :ports)))
        (holes (mapcar (lambda(h)
          (let ((owners (remove-if-not (lambda(o)(equal (shg-operations-body o) (shg-id h))) (shg-items g :operations))))
           (shg-require (= 1 (length owners)) :unsupported-profile "A hole needs exactly one operation owner")
           (make-semantic-hole-row-v1 :local-hole-key (shg-id h) :hole-kind :refinement
            :owner-ref (semantic-member-row-v1-member-row-identity (find (shg-id (first owners)) members :key #'semantic-member-row-v1-local-member-key))
            :required-contract-refs (list (shg-holes-boundary h)) :required-formal-refs (shg-holes-obligations h)))) (shg-items g :holes)))
        (base (make-semantic-bundle-base-registry-set-v1 :member-registry-ref (shg-root :member-registry-v1 members)
          :port-registry-ref (shg-root :port-registry-v1 ports) :relation-registry-ref (shg-root :relation-registry-v1 nil)
          :incidence-registry-ref (shg-root :incidence-registry-v1 nil) :hole-registry-ref (shg-root :hole-registry-v1 holes)))
        (bundle (make-recursive-semantic-bundle-v1 :bundle-kind :program :subject-semantic-ref (list :semantic-hypergraph (semantic-hypergraph-v1-id g))
          :base-registry-set-ref base :closure-law-set-ref :hand-shg-structural-v1)) (env (shg-close bundle)))
  (labels ((apply-app (app)
    (let* ((delta (materialize-semantic-relation-v1 app (semantic-bundle-closure-v1-bundle-snapshot-ref (getf env :closure))))
           (old (mapcar #'semantic-relation-row-v1-relation-row-identity (recursive-semantic-bundle-base-rows-v1 bundle :relation-registry-v1))))
     (setf bundle (apply-semantic-bundle-delta-v1 bundle (getf env :closure) delta) env (shg-close bundle))
     (or (find-if (lambda(r)(not (member (semantic-relation-row-v1-relation-row-identity r) old :test #'equal)))
          (recursive-semantic-bundle-base-rows-v1 bundle :relation-registry-v1))
         (shg-fail :relation "Duplicate native relation application is outside this profile")))))
   (dolist (r (shg-items g :relations))
    (let* ((source (find (third (first (shg-relations-ends r))) ports :key #'semantic-port-row-v1-local-port-key))
           (target (find (third (second (shg-relations-ends r))) ports :key #'semantic-port-row-v1-local-port-key))
           (class (shg-ports-value-type (shg-find g :ports (third (first (shg-relations-ends r))))))
           (goal (make-semantic-relation-goal-v1 :family :wiring :required-roles '(:source :target)
             :role-bindings (list (list :source :port (semantic-port-row-v1-port-row-identity source)) (list :target :port (semantic-port-row-v1-port-row-identity target)))
             :parameter-bindings (list :source-surface (make-semantic-boundary-surface-v1 :output-port-classes (list class))
              :target-surface (make-semantic-boundary-surface-v1 :input-port-classes (list class)))))
           (native (apply-app (plan-semantic-relation-goal-v1 goal))))
     (push (cons (shg-id r) (semantic-relation-row-v1-relation-row-identity native)) (semantic-hypergraph-v1-relation-map g))))
   (dolist (d (shg-dependency-intents g))
    (let* ((source (semantic-member-row-v1-member-row-identity (find (first d) members :key #'semantic-member-row-v1-local-member-key)))
           (port (find (second d) ports :key #'semantic-port-row-v1-local-port-key))
           (target (if port (semantic-port-row-v1-port-row-identity port) (semantic-member-row-v1-member-row-identity (find (second d) members :key #'semantic-member-row-v1-local-member-key)))))
     (apply-app (make-semantic-relation-application-v1 :constitution-ref :minimum-core-contract-dependency-v1
       :role-bindings (list (list :contract :semantic-value source) (list :dependent (if port :port :member) target))
       :parameter-bindings (list :dependency-kind (third d) :source-generation (semantic-hypergraph-v1-generation g)))))))
  (setf (semantic-hypergraph-v1-envelope g) env)
  (let ((routes (shg-derived-routes g)))
   (setf env (shg-close bundle routes) (semantic-hypergraph-v1-envelope g) env (semantic-hypergraph-v1-routes g) routes))
  ;; Snapshot first; addresses and exact obligation subjects are derived afterward.
  ;; No address enters its own snapshot digest.
  (dolist (kind (append *semantic-bundle-base-registry-kinds-v1* *semantic-bundle-generated-registry-kinds-v1*))
   (dolist (row (semantic-registry-root-v1-rows (semantic-bundle-row-address-root-v1 bundle (getf env :generated-set) kind)))
    (push (minimum-core-row-address-v1 env kind row (list (semantic-hypergraph-v1-id g))) (semantic-hypergraph-v1-addresses g))))
  (dolist (e (shg-items g :evidence))
   (let* ((alias (shg-find g :addresses (shg-evidence-subject e)))
          (row (shg-member g (shg-addresses-member alias))))
    (push (cons (shg-id e) (shg-address-for g :member-registry-v1 row)) (semantic-hypergraph-v1-proof-subjects g))))
  (shg-check g) g)))
(defun shg-address-for (g kind row)
 (let* ((env (semantic-hypergraph-v1-envelope g))
        (expected (minimum-core-row-address-v1 env kind row (list (semantic-hypergraph-v1-id g))))
        (actual (find (semantic-bundle-row-address-v1-address-identity expected) (semantic-hypergraph-v1-addresses g)
                 :key #'semantic-bundle-row-address-v1-address-identity :test #'equal)))
  (shg-require (equalp expected actual) :address "Address differs from reconstruction against canonical snapshot") actual))
(defun shg-resolve (g key &optional kind)
 (let* ((env (semantic-hypergraph-v1-envelope g))
        (mapped (cdr (assoc key (semantic-hypergraph-v1-relation-map g))))
        (kind (or kind (if mapped :relation-registry-v1 :member-registry-v1)))
        (row (if (eq kind :member-registry-v1) (shg-member g key)
                (semantic-registry-root-find-row-v1 (semantic-bundle-row-address-root-v1 (getf env :bundle) (getf env :generated-set) kind) (or mapped key)))))
  (shg-require row :missing "Unknown native row")
  (resolve-semantic-bundle-row-address-v1 (shg-address-for g kind row) (getf env :bundle) (getf env :closure) (getf env :generated-set))))
(defun shg-view (g)
 (let ((env (semantic-hypergraph-v1-envelope g)))
  (interpret-semantic-bundle-hypergraph-v1 (getf env :bundle) (getf env :closure) (getf env :generated-set))))
(defun shg-derived-routes (g)
 (let ((bundle (getf (semantic-hypergraph-v1-envelope g) :bundle)))
  (loop for r in (shg-base-rows g :relation-registry-v1) when (eq :dataflow (semantic-relation-row-v1-relation-kind r)) collect
   (let ((ends (semantic-bundle-incidences-for-relation-v1 r (shg-base-rows g :incidence-registry-v1))))
    (make-semantic-generated-registry-row-v1 :registry-kind :route-registry-v1
     :payload (list :status :symbolic :execution :unbound :relation-ref (semantic-relation-row-v1-relation-row-identity r)
       :source-port-ref (semantic-incidence-row-v1-participant-ref (find :source ends :key #'semantic-incidence-row-v1-role))
       :target-port-ref (semantic-incidence-row-v1-participant-ref (find :target ends :key #'semantic-incidence-row-v1-role)))
     :generator-ref :hand-shg-route-projection-v1 :generation-law-ref :relation-endpoints-v1
     :input-row-refs (list (semantic-relation-row-v1-relation-row-identity r)) :origin-bundle-refs (list (recursive-semantic-bundle-v1-bundle-identity bundle)))))))
(defun shg-route (g &optional relation-id)
 (let* ((mapped (cdr (assoc relation-id (semantic-hypergraph-v1-relation-map g))))
        (routes (shg-derived-routes g))
        (row (if mapped (find mapped routes :test #'equal :key (lambda(r)(getf (semantic-generated-registry-row-v1-payload r) :relation-ref))) (first routes))))
  (shg-require row :missing "Unknown symbolic route")
  (loop for k in '(:source-port-ref :target-port-ref) collect (shg-resolve g (getf (semantic-generated-registry-row-v1-payload row) k) :port-registry-v1))))
(defun shg-sort-routes (rows) (sort (copy-list rows) #'string< :key #'semantic-generated-registry-row-v1-row-identity))
(defun shg-check (g)
 (shg-validate g)
 (let* ((env (semantic-hypergraph-v1-envelope g)) (bundle (getf env :bundle)))
  (validate-semantic-bundle-persistence-envelope-v1 env)
  (shg-require (= (length (shg-base-rows g :member-registry-v1)) (1+ (loop for c in (semantic-hypergraph-v1-universe g) sum (length (cdr c))))) :correspondence "Missing/additional native members")
  (shg-require (and (= (length (shg-items g :ports)) (length (shg-base-rows g :port-registry-v1)))
    (= (length (shg-items g :holes)) (length (shg-base-rows g :hole-registry-v1)))) :correspondence "Missing/additional ports or holes")
  (shg-require (equalp (shg-header g) (semantic-member-row-v1-semantic-ref (shg-member g (semantic-hypergraph-v1-root g)))) :correspondence "Root header diverges from H001")
  (shg-require (equal (recursive-semantic-bundle-v1-subject-semantic-ref bundle) (list :semantic-hypergraph (semantic-hypergraph-v1-id g))) :correspondence "Bundle subject diverges")
  (dolist (collection (semantic-hypergraph-v1-universe g))
   (dolist (r (cdr collection))
    (shg-require (equalp (shg-form (car collection) r) (semantic-member-row-v1-semantic-ref (shg-member g (shg-id r)))) :correspondence "SHG declaration diverges from native member")))
  (let ((expected-count 0))
   (dolist (kind (append *semantic-bundle-base-registry-kinds-v1* *semantic-bundle-generated-registry-kinds-v1*))
    (dolist (row (semantic-registry-root-v1-rows (semantic-bundle-row-address-root-v1 bundle (getf env :generated-set) kind)))
     (incf expected-count) (shg-address-for g kind row)))
   (shg-require (= expected-count (length (semantic-hypergraph-v1-addresses g))) :address "Missing or additional native address"))
  (dolist (p (shg-items g :ports))
   (let ((row (shg-port g (shg-id p))))
    (shg-require (and (equal (semantic-port-row-v1-owner-ref row) (semantic-member-row-v1-member-row-identity (shg-member g (shg-ports-owner p))))
      (equal (semantic-port-row-v1-direction row) (shg-ports-direction p)) (equal (semantic-port-row-v1-surface-ref row) (shg-ports-value-type p))
      (equal (semantic-port-row-v1-contract-ref row) (shg-ports-contract p)) (equal (semantic-port-row-v1-effect-profile-ref row) (shg-ports-effects p))) :correspondence "Dedicated port disagrees with declaration")))
  (shg-require (= (length (shg-items g :relations)) (length (semantic-hypergraph-v1-relation-map g))
    (count :dataflow (shg-base-rows g :relation-registry-v1) :key #'semantic-relation-row-v1-relation-kind)) :relation "Missing/additional dataflow relations")
  (dolist (r (shg-items g :relations))
   (let* ((native (getf (shg-resolve g (shg-id r)) :row)) (ends (semantic-bundle-incidences-for-relation-v1 native (shg-base-rows g :incidence-registry-v1))))
    (shg-require (and (eq :dataflow (semantic-relation-row-v1-relation-kind native)) (= 2 (length ends))) :relation "Wrong native relation")
    (dolist (end (shg-relations-ends r))
     (let ((inc (find (first end) ends :key #'semantic-incidence-row-v1-role)))
      (shg-require (and inc (eq :port (semantic-incidence-row-v1-participant-kind inc))
        (equal (semantic-incidence-row-v1-participant-ref inc) (semantic-port-row-v1-port-row-identity (shg-port g (third end))))) :relation "Incidence correspondence mismatch")))))
  (let* ((intents (shg-dependency-intents g)) (native (remove :dataflow (shg-base-rows g :relation-registry-v1) :key #'semantic-relation-row-v1-relation-kind)))
   (shg-require (= (length intents) (length native)) :dependency "Missing/additional dependencies")
   (dolist (d intents)
    (let* ((source (semantic-member-row-v1-member-row-identity (shg-member g (first d))))
           (port (find (second d) (shg-base-rows g :port-registry-v1) :key #'semantic-port-row-v1-local-port-key))
           (target (if port (semantic-port-row-v1-port-row-identity port) (semantic-member-row-v1-member-row-identity (shg-member g (second d)))))
           (matches (remove-if-not (lambda(r)
             (let ((ends (semantic-bundle-incidences-for-relation-v1 r (shg-base-rows g :incidence-registry-v1))))
              (and (equal (semantic-relation-row-v1-constitution-ref r) (semantic-relation-constitution-v2-constitution-identity (semantic-bundle-resolve-relation-constitution-v1 :minimum-core-contract-dependency-v1)))
               (eq (third d) (getf (semantic-relation-row-v1-parameter-bindings r) :dependency-kind))
               (eql 0 (getf (semantic-relation-row-v1-parameter-bindings r) :source-generation))
               (equal source (semantic-incidence-row-v1-participant-ref (find :contract ends :key #'semantic-incidence-row-v1-role)))
               (equal target (semantic-incidence-row-v1-participant-ref (find :dependent ends :key #'semantic-incidence-row-v1-role)))))) native)))
     (shg-require (= 1 (length matches)) :dependency "Dependency does not match source declaration"))))
  (dolist (h (shg-items g :holes))
   (let ((native (find (shg-id h) (shg-base-rows g :hole-registry-v1) :key #'semantic-hole-row-v1-local-hole-key))
         (owners (remove-if-not (lambda(o)(equal (shg-id h) (shg-operations-body o))) (shg-items g :operations))))
    (shg-require (and native (= 1 (length owners))
      (equal (semantic-hole-row-v1-owner-ref native) (semantic-member-row-v1-member-row-identity (shg-member g (shg-id (first owners)))))
      (equal (semantic-hole-row-v1-required-contract-refs native) (list (shg-holes-boundary h)))
      (equal (semantic-hole-row-v1-required-formal-refs native) (shg-holes-obligations h))) :correspondence "Hole correspondence mismatch")))
  (shg-require (= (length (semantic-hypergraph-v1-proof-subjects g)) (length (shg-items g :evidence))) :proof "Missing proof subjects")
  (dolist (e (shg-items g :evidence))
   (let* ((alias (shg-find g :addresses (shg-evidence-subject e)))
          (expected (shg-address-for g :member-registry-v1 (shg-member g (shg-addresses-member alias))))
          (actual (cdr (assoc (shg-id e) (semantic-hypergraph-v1-proof-subjects g)))))
    (shg-require (and (equal (shg-addresses-path alias) (list (semantic-hypergraph-v1-id g))) (equalp expected actual)) :proof "Proof subject is not the exact H002 address")))
  (let ((derived (shg-derived-routes g)) (stored (semantic-registry-root-v1-rows (semantic-bundle-generated-root-v1 (getf env :generated-set) :route-registry-v1))))
   (shg-require (and (equalp (shg-sort-routes derived) (shg-sort-routes stored)) (equalp (shg-sort-routes derived) (shg-sort-routes (semantic-hypergraph-v1-routes g)))) :route "Route registry/projection differs from A002 incidences"))
  (shg-view g)
  (setf (semantic-hypergraph-v1-checks g) '(:structural :checked :predicates :retained :behavioral :unverified :execution :unbound :profile :generation-zero-read-only-dataflow))) t)
(defun shg-rejects (fn &optional category)
 (handler-case (progn (funcall fn) nil)
  (shg-error(e)(if category (eq category (shg-error-category e)) t))))
(defun shg-describe (g)
 (let ((env (semantic-hypergraph-v1-envelope g)))
  (list :graph (semantic-hypergraph-v1-id g) :root (semantic-hypergraph-v1-root g)
   :root-address (getf (shg-resolve g (semantic-hypergraph-v1-root g)) :address-ref)
   :generation (semantic-hypergraph-v1-generation g)
   :snapshot (semantic-bundle-snapshot-ref-v1-snapshot-identity (semantic-bundle-closure-v1-bundle-snapshot-ref (getf env :closure)))
   :collections (mapcar (lambda(c)(list (car c) (length (cdr c)))) (semantic-hypergraph-v1-universe g))
   :registries (mapcar (lambda(k)(list k (semantic-registry-root-v1-registry-root-identity (semantic-bundle-generated-root-v1 (getf env :generated-set) k)))) *semantic-bundle-generated-registry-kinds-v1*)
   :checks (semantic-hypergraph-v1-checks g))))
(defun shg-neighbors (g key)
 (let* ((member (find key (shg-base-rows g :member-registry-v1) :key #'semantic-member-row-v1-local-member-key))
        (port (find key (shg-base-rows g :port-registry-v1) :key #'semantic-port-row-v1-local-port-key))
        (refs (remove nil (list (and member (semantic-member-row-v1-member-row-identity member)) (and port (semantic-port-row-v1-port-row-identity port))))))
  (shg-require refs :missing "Unknown neighborhood subject")
  (remove-if-not (lambda(r)(some (lambda(i)(member (getf i :participant-ref) refs :test #'equal)) (getf r :incidences)))
    (semantic-bundle-relation-projection-v1 (shg-view g) (remove-duplicates (mapcar #'semantic-relation-row-v1-relation-kind (shg-base-rows g :relation-registry-v1)))))))
(defun shg-obligations (g)
 (loop for e in (shg-items g :evidence) collect
  (list :id (shg-id e) :subject-address (cdr (assoc (shg-id e) (semantic-hypergraph-v1-proof-subjects g)))
   :claim (shg-evidence-claim e) :status (shg-evidence-status e) :semantics :unverified)))
(defun shg-cli ()
 (let* ((args (uiop:command-line-arguments)) (cmd (or (first args) "describe"))
        (path (or (uiop:getenv "SHG_ARTIFACT") (merge-pathnames "working/shg-stack.sexp" cl-user::*shg-directory*))))
  (ensure-directories-exist path)
  (if (equal cmd "build")
   (let ((g (shg-native-build (shg-fixture))))
    (working-write path g) (let ((r (working-read path))) (shg-check r) (assert (equalp g r)))
    (format t "SHG_BUILD_RELOAD_GREEN addresses=~D routes=~D behavioral=UNVERIFIED~%" (length (semantic-hypergraph-v1-addresses g)) (length (semantic-hypergraph-v1-routes g))))
   (let* ((g (working-read path)) (key (when (second args) (if (equal (second args) "/G") '/g (intern (string-upcase (second args)) :keyword)))))
    (shg-check g)
    (let ((result
     (cond
      ((equal cmd "describe") (shg-describe g))
      ((equal cmd "show") (loop for c in (semantic-hypergraph-v1-universe g) collect (cons (car c) (mapcar (lambda(r)(shg-form (car c) r)) (cdr c)))))
      ((equal cmd "dump") g)
      ((equal cmd "resolve")
       (let* ((hole (find key (shg-base-rows g :hole-registry-v1) :key #'semantic-hole-row-v1-local-hole-key))
              (res (if hole (shg-resolve g (semantic-hole-row-v1-hole-row-identity hole) :hole-registry-v1) (shg-resolve g key))))
        (list :address (getf res :address-ref) :snapshot (getf res :bundle-snapshot-ref) :registry (getf res :registry-kind) :row (getf res :row))))
      ((equal cmd "relations") (semantic-bundle-relation-projection-v1 (shg-view g) '(:dataflow)))
      ((equal cmd "dependencies") (semantic-bundle-relation-projection-v1 (shg-view g) (remove :dataflow (remove-duplicates (mapcar #'semantic-relation-row-v1-relation-kind (shg-base-rows g :relation-registry-v1))))))
      ((equal cmd "neighbors") (shg-neighbors g key))
      ((equal cmd "obligations") (shg-obligations g))
      ((equal cmd "route") (list :status :symbolic :execution :unbound :endpoints
       (mapcar (lambda(end)(list :port (semantic-port-row-v1-local-port-key (getf end :row)) :address (getf end :address-ref))) (shg-route g key))))
      (t (error "Usage: build | describe | show | dump | resolve ID | relations | dependencies | neighbors ID | obligations | route [RELATION]")))))
     (let ((*print-pretty* t)) (write result) (terpri)))))))
(unless (member :shg-library *features*) (shg-cli))
