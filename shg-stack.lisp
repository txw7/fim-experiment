;;; Bounded handwritten SHG extension. H001/H002 remain native owners.
(require :asdf)
;; Reuse the existing loader/helpers, without running its CLI.
(with-open-file (s (merge-pathnames "synthesis/working_graph.lisp" (uiop:pathname-directory-pathname *load-truename*)))
 (loop for form = (read s nil :end) until (eq form :end) do
  (when (and (consp form) (eq (first form) 'let*)
             (search "COMMAND-LINE-ARGUMENTS" (write-to-string form))) (return))
  (eval form)))
(in-package #:lsip)
(load (merge-pathnames "lisp/semantic_bundle_route_query_v1.lisp" cl-user::*mc-root*))

(minimum-core-install-dependency-constitution-v1)

(defparameter *shg-shapes*
 '((:types id schema refinements)
   (:effects id input output constraints)
   (:contracts id assume guarantee invariants effects dependencies)
   (:ports id owner direction value-type effects contract)
   (:node-types id ports operations machine contract)
   (:occurrences id type parent generation state memory provider body)
   (:relations id type ends contract effects handler)
   (:machines id states initial transitions)
   (:operations id boundary preconditions postconditions effects body contract)
   (:memory id slots)
   (:holes id boundary obligations)
   (:addresses id root generation path member)
   (:bindings id provider capability realization contract)
   (:evidence id kind subject generation digest claim method status evidence)
   (:history id predecessor successor rule delta verification admission)))
;; Explicit extension record types and field codecs, not an opaque JSON blob.
(dolist (shape *shg-shapes*)
 (eval `(defstruct ,(intern (format nil "SHG-~A" (first shape))) ,@(rest shape))))
(defstruct semantic-hypergraph-v1
 id version generation root universe transformations projections invariants lifecycle
 envelope addresses routes checks)
(defun shg-record (kind &rest fields)
 (let* ((shape (or (assoc kind *shg-shapes*) (error "Unsupported SHG collection ~S" kind)))
        (allowed (mapcar (lambda (x) (intern (symbol-name x) :keyword)) (rest shape))))
  (loop for (key value) on fields by #'cddr do
   (unless (member key allowed) (error "Unsupported field ~S" key)))
  (apply (symbol-function (intern (format nil "MAKE-SHG-~A" kind))) fields)))
(defun shg-form (kind record)
 (cons kind (loop for slot in (rest (assoc kind *shg-shapes*)) append
  (list (intern (symbol-name slot) :keyword) (slot-value record slot)))))
(defun shg-id (r) (slot-value r 'id))
(defun shg-items (g kind) (cdr (assoc kind (semantic-hypergraph-v1-universe g))))
(defun shg-find (g kind id)
 (or (find id (shg-items g kind) :key #'shg-id :test #'equal)
     (error "Missing ~S reference ~S" kind id)))
(defun shg-validate (g)
 (unless (and (equal (semantic-hypergraph-v1-version g) '(0 1))
              (integerp (semantic-hypergraph-v1-generation g))
              (>= (semantic-hypergraph-v1-generation g) 0)
              (equal (mapcar #'car (semantic-hypergraph-v1-universe g)) (mapcar #'car *shg-shapes*)))
  (error "SHG header/collection mismatch"))
 (let ((ids nil))
  (dolist (collection (semantic-hypergraph-v1-universe g))
   (dolist (r (cdr collection))
    (unless (typep r (intern (format nil "SHG-~A" (car collection)))) (error "Wrong record type"))
    (when (member (shg-id r) ids :test #'equal) (error "Duplicate object identity"))
    (push (shg-id r) ids))))
 (dolist (e (shg-items g :effects))
  (shg-find g :types (shg-effects-input e)) (shg-find g :types (shg-effects-output e)))
 (dolist (c (shg-items g :contracts))
  (dolist (e (shg-contracts-effects c)) (shg-find g :effects e))
  (dolist (d (shg-contracts-dependencies c)) (shg-find g :contracts d)))
 (dolist (p (shg-items g :ports))
  (unless (member (shg-ports-direction p) '(:in :out :inout)) (error "Invalid direction"))
  (shg-find g :occurrences (shg-ports-owner p))
  (shg-find g :types (shg-ports-value-type p)) (shg-find g :contracts (shg-ports-contract p))
  (dolist (e (shg-ports-effects p)) (shg-find g :effects e)))
 (dolist (n (shg-items g :node-types))
  (dolist (p (shg-node-types-ports n)) (shg-find g :ports p))
  (dolist (o (shg-node-types-operations n)) (shg-find g :operations o))
  (shg-find g :machines (shg-node-types-machine n)) (shg-find g :contracts (shg-node-types-contract n)))
 (dolist (o (shg-items g :occurrences))
  (shg-find g :node-types (shg-occurrences-type o))
  (unless (= (shg-occurrences-generation o) (semantic-hypergraph-v1-generation g)) (error "Stale occurrence"))
  (unless (eq :none (shg-occurrences-parent o)) (shg-find g :occurrences (shg-occurrences-parent o)))
  (unless (eq :unbound (shg-occurrences-memory o)) (shg-find g :memory (shg-occurrences-memory o)))
  (unless (eq :unbound (shg-occurrences-provider o)) (shg-find g :bindings (shg-occurrences-provider o)))
  (shg-find g :holes (shg-occurrences-body o)))
 (dolist (o (shg-items g :operations))
  (shg-find g :contracts (shg-operations-contract o))
  (shg-find g :holes (shg-operations-body o))
  (dolist (p (append (getf (shg-operations-boundary o) :inputs) (getf (shg-operations-boundary o) :outputs)))
   (shg-find g :ports p)))
 (dolist (h (shg-items g :holes))
  (shg-find g :contracts (shg-holes-boundary h))
  (dolist (o (shg-holes-obligations h)) (shg-find g :evidence o)))
 (dolist (r (shg-items g :relations))
  (unless (eq (shg-relations-type r) :dataflow) (error "Unsupported relation profile"))
  (shg-find g :contracts (shg-relations-contract r))
  (unless (equal (mapcar #'first (shg-relations-ends r)) '(:source :target)) (error "Invalid relation roles"))
  (dolist (end (shg-relations-ends r))
   (let ((port (shg-find g :ports (third end))))
    (unless (and (equal (shg-ports-owner port) (second end))
                 (eq (shg-ports-direction port) (if (eq (first end) :source) :out :in)))
     (error "Invalid relation endpoint")))))
 (dolist (m (shg-items g :machines))
  (unless (member (shg-machines-initial m) (shg-machines-states m)) (error "Invalid initial state"))
  (dolist (tr (shg-machines-transitions m))
   (unless (and (member (getf tr :from) (shg-machines-states m))
                (member (getf tr :to) (shg-machines-states m))) (error "Invalid transition"))
   (shg-find g :operations (getf tr :operation)) (shg-find g :contracts (getf tr :contract))))
 (dolist (m (shg-items g :memory))
  (dolist (s (shg-memory-slots m)) (shg-find g :types (getf s :type))))
 (dolist (b (shg-items g :bindings)) (shg-find g :contracts (shg-bindings-contract b)))
 (dolist (a (shg-items g :addresses))
  (unless (and (eq (shg-addresses-root a) (semantic-hypergraph-v1-id g))
               (= (shg-addresses-generation a) (semantic-hypergraph-v1-generation g))) (error "Stale semantic address")))
 (dolist (e (shg-items g :evidence))
  (shg-find g :addresses (shg-evidence-subject e))
  (unless (= (shg-evidence-generation e) (semantic-hypergraph-v1-generation g)) (error "Stale evidence"))
  (unless (member (shg-evidence-status e) '(:open :proven :refuted :unknown)) (error "Invalid proof status"))
  (when (and (eq :proven (shg-evidence-status e)) (null (shg-evidence-evidence e))) (error "Unsupported proven claim")))
 t)

(defun shg-fixture ()
 (let ((g (make-semantic-hypergraph-v1 :id :g :version '(0 1) :generation 0 :root '/g :lifecycle :instantiated
  :universe (mapcar (lambda (s) (list (car s))) *shg-shapes*)
  :transformations
  '((:instantiate :requires (:valid-node-type :lawful-placement) :produces (:distinct-occurrence :declared-ports))
    (:open-body :requires (:declared-operation-boundary) :produces (:typed-hole :refinement-obligations))
    (:nest :requires (:compatible-child-boundary) :produces (:parent-child-correspondence))
    (:relate :requires (:valid-relation-constitution) :produces (:relation :role-bearing-incidences))
    (:derive-dependency :requires (:referenced-contract-or-type) :produces (:dependency-relation))
    (:refine :requires (:boundary-preservation :state-effect-preservation :behavioral-refinement) :produces (:successor-body :proof-obligations))
    (:revise :requires (:identified-generation :explicit-graph-delta) :produces (:successor-generation :revision-record))
    (:admit :requires (:verified-obligations :valid-contracts :consistent-addresses) :produces (:admitted-generation)))
  :projections '((:structural :occurrences :ports :relations :addresses)
    (:operational :machines :operations :effects :memory) (:dependency :contracts :dependency-relations)
    (:verification :invariants :obligations :evidence) (:synthesis :operations :machines :bindings :target :stack-synth)
    (:routing :bindings :addresses :contracts :target :route-registry) (:evolution :transformations :revisions :history))
  :invariants '(:unique-occurrence-identities :well-typed-port-incidences :well-formed-role-assignments
    :valid-parent-child-boundaries :stable-generation-addressing :declared-effects-only
    :transition-contract-consistency :refinement-preserves-external-contract :admission-requires-verification))))
  (flet ((add (k &rest f) (push (apply #'shg-record k f) (cdr (assoc k (semantic-hypergraph-v1-universe g))))))
   (add :types :id :t :schema '(:nominal :message-v1) :refinements nil)
   (add :effects :id :e :input :t :output :t :constraints '(:declared-only))
   (add :contracts :id :c :assume '(:typed-input) :guarantee '(:typed-output) :invariants '(:boundary-preserved) :effects '(:e) :dependencies nil)
   (add :node-types :id :n :ports '(:p-in :p-out) :operations '(:op) :machine :m :contract :c)
   (add :occurrences :id :instance :type :n :parent :none :generation 0 :state :idle :memory :mem :provider :binding :body :h)
   (add :ports :id :p-in :owner :instance :direction :in :value-type :t :effects '(:e) :contract :c)
   (add :ports :id :p-out :owner :instance :direction :out :value-type :t :effects '(:e) :contract :c)
   (add :operations :id :op :boundary '(:inputs (:p-in) :outputs (:p-out)) :preconditions '(:typed-input) :postconditions '(:typed-output) :effects '(:e) :body :h :contract :c)
   (add :machines :id :m :states '(:idle :done) :initial :idle :transitions '((:id :advance :from :idle :to :done :trigger :message-v1 :guard :typed-input :operation :op :effects (:e) :contract :c)))
   (add :memory :id :mem :slots '((:id :slot :type :t :value :uninitialized)))
   (add :holes :id :h :boundary :c :obligations '(:proof))
   (add :addresses :id :op-address :root :g :generation 0 :path '(:g) :member :op)
   (add :bindings :id :binding :provider :unbound :capability :unbound :realization :unbound :contract :c)
   (add :evidence :id :proof :kind :obligation :subject :op-address :generation 0 :claim :implementation-refines-contract :method :unbound :status :open :evidence nil))
  (shg-validate g) g))
(defun shg-root (kind rows)
 (make-semantic-registry-root-v1 :registry-kind kind :rows rows :generation-law-ref :hand-shg-v1))
(defun shg-close (b &optional route-rows)
 (multiple-value-bind (c r) (close-recursive-semantic-bundle-v1 b :route-rows route-rows)
  (semantic-bundle-persistence-envelope-v1 b r c)))
(defun shg-native-build (g)
 (with-semantic-boundary-surface-context-v1
 (shg-validate g)
 (let* ((records (loop for (kind . rows) in (semantic-hypergraph-v1-universe g) append
                  (mapcar (lambda (r) (cons kind r)) rows)))
        (members (cons (make-semantic-member-row-v1 :local-member-key '/g :member-kind :semantic-object
                       :semantic-ref (list :semantic-hypergraph :g :version '(0 1) :generation 0
                         :transformations (semantic-hypergraph-v1-transformations g)
                         :collections (mapcar #'car *shg-shapes*)
                         :projections (semantic-hypergraph-v1-projections g)
                         :invariants (semantic-hypergraph-v1-invariants g) :lifecycle :instantiated))
                (mapcar (lambda (entry) (make-semantic-member-row-v1 :local-member-key (shg-id (cdr entry))
                     :member-kind (if (eq (car entry) :operations) :operation :semantic-object)
                     :semantic-ref (shg-form (car entry) (cdr entry)))) records)))
        (ports (mapcar (lambda (p) (make-semantic-port-row-v1 :local-port-key (shg-id p)
          :owner-kind :member :owner-ref (semantic-member-row-v1-member-row-identity
            (find (shg-ports-owner p) members :key #'semantic-member-row-v1-local-member-key))
          :port-kind :data :direction (shg-ports-direction p) :contract-ref (shg-ports-contract p)
          :surface-ref (shg-ports-value-type p) :effect-profile-ref (shg-ports-effects p) :visibility :bundle-export)) (shg-items g :ports)))
        (hole (make-semantic-hole-row-v1 :local-hole-key :h :hole-kind :refinement
          :owner-ref (semantic-member-row-v1-member-row-identity (find :op members :key #'semantic-member-row-v1-local-member-key))
          :required-contract-refs '(:c) :required-formal-refs '(:proof)))
        (base (make-semantic-bundle-base-registry-set-v1 :member-registry-ref (shg-root :member-registry-v1 members)
          :port-registry-ref (shg-root :port-registry-v1 ports) :relation-registry-ref (shg-root :relation-registry-v1 nil)
          :incidence-registry-ref (shg-root :incidence-registry-v1 nil) :hole-registry-ref (shg-root :hole-registry-v1 (list hole))))
        (bundle (make-recursive-semantic-bundle-v1 :bundle-kind :program :subject-semantic-ref '(:semantic-hypergraph :g)
           :base-registry-set-ref base :closure-law-set-ref :hand-shg-structural-v1))
        (env (shg-close bundle)))
  ;; A002 plans/materializes a real association between typed ports.
  (let* ((source (find :p-out ports :key #'semantic-port-row-v1-local-port-key))
         (target (find :p-in ports :key #'semantic-port-row-v1-local-port-key))
         (goal (make-semantic-relation-goal-v1 :family :wiring :required-roles '(:source :target)
          :role-bindings (list (list :source :port (semantic-port-row-v1-port-row-identity source))
                              (list :target :port (semantic-port-row-v1-port-row-identity target)))
          :parameter-bindings (list :source-surface (make-semantic-boundary-surface-v1 :output-port-classes '(:c))
                                   :target-surface (make-semantic-boundary-surface-v1 :input-port-classes '(:c)))))
         (app (plan-semantic-relation-goal-v1 goal))
         (delta (materialize-semantic-relation-v1 app (semantic-bundle-closure-v1-bundle-snapshot-ref (getf env :closure)))))
   (setf bundle (apply-semantic-bundle-delta-v1 bundle (getf env :closure) delta)
         env (shg-close bundle))
   (push (shg-record :relations :id :r :type :dataflow :ends '((:source :instance :p-out) (:target :instance :p-in))
                    :contract :c :effects '(:e) :handler :unbound) (cdr (assoc :relations (semantic-hypergraph-v1-universe g)))))
  ;; Derive type/effect/port dependencies through the existing native constitution.
  (dolist (dependency '((:t :e :effect-input-type) (:t :p-in :port-value-type)
                        (:t :p-out :port-value-type) (:e :p-in :port-effect) (:e :p-out :port-effect)))
   (let* ((source (semantic-member-row-v1-member-row-identity
                   (find (first dependency) members :key #'semantic-member-row-v1-local-member-key)))
          (port (find (second dependency) ports :key #'semantic-port-row-v1-local-port-key))
          (target (if port (semantic-port-row-v1-port-row-identity port)
                   (semantic-member-row-v1-member-row-identity
                    (find (second dependency) members :key #'semantic-member-row-v1-local-member-key))))
          (app (make-semantic-relation-application-v1 :constitution-ref :minimum-core-contract-dependency-v1
                 :role-bindings (list (list :contract :semantic-value source)
                                      (list :dependent (if port :port :member) target))
                 :parameter-bindings (list :dependency-kind (third dependency) :source-generation 0)))
          (delta (materialize-semantic-relation-v1 app
                   (semantic-bundle-closure-v1-bundle-snapshot-ref (getf env :closure)))))
    (setf bundle (apply-semantic-bundle-delta-v1 bundle (getf env :closure) delta)
          env (shg-close bundle))))
  ;; Symbolic navigation row derived from actual materialized relation and port rows.
  ;; No external R001 selection or executable admission is asserted.
  (let* ((relation (find :dataflow (recursive-semantic-bundle-base-rows-v1 bundle :relation-registry-v1) :key #'semantic-relation-row-v1-relation-kind))
         (row (make-semantic-generated-registry-row-v1 :registry-kind :route-registry-v1
          :payload (list :status :symbolic :execution :unbound :relation-ref (semantic-relation-row-v1-relation-row-identity relation)
             :source-port-ref (semantic-port-row-v1-port-row-identity (find :p-out ports :key #'semantic-port-row-v1-local-port-key))
             :target-port-ref (semantic-port-row-v1-port-row-identity (find :p-in ports :key #'semantic-port-row-v1-local-port-key)))
          :generator-ref :hand-shg-route-projection-v1 :generation-law-ref :relation-endpoints-v1
          :input-row-refs (list (semantic-relation-row-v1-relation-row-identity relation))
          :origin-bundle-refs (list (recursive-semantic-bundle-v1-bundle-identity bundle)))))
   (setf env (shg-close bundle (list row)) (semantic-hypergraph-v1-routes g) (list row)))
  (setf (semantic-hypergraph-v1-envelope g) env)
  (dolist (kind (append *semantic-bundle-base-registry-kinds-v1* *semantic-bundle-generated-registry-kinds-v1*))
   (dolist (row (semantic-registry-root-v1-rows (semantic-bundle-row-address-root-v1 bundle (getf env :generated-set) kind)))
    (let ((a (minimum-core-row-address-v1 env kind row '(:g))))
     (push a (semantic-hypergraph-v1-addresses g))
     (push (shg-record :addresses :id (semantic-bundle-row-address-v1-address-identity a) :root :g :generation 0
               :path '(:g) :member (semantic-registry-row-identity-v1 row)) (cdr (assoc :addresses (semantic-hypergraph-v1-universe g)))))))
  (shg-validate g) g)))
(defun shg-resolve (g key &optional (kind :member-registry-v1))
 (when (eq key :r)
  (let* ((env (semantic-hypergraph-v1-envelope g))
         (r (find :dataflow (recursive-semantic-bundle-base-rows-v1 (getf env :bundle) :relation-registry-v1)
              :key #'semantic-relation-row-v1-relation-kind)))
   (return-from shg-resolve (shg-resolve g (semantic-relation-row-v1-relation-row-identity r) :relation-registry-v1))))
 (let* ((env (semantic-hypergraph-v1-envelope g))
        (root (semantic-bundle-row-address-root-v1 (getf env :bundle) (getf env :generated-set) kind))
        (row (if (eq kind :member-registry-v1)
                 (find key (semantic-registry-root-v1-rows root) :key #'semantic-member-row-v1-local-member-key :test #'equal)
                 (semantic-registry-root-find-row-v1 root key))))
  (unless row (error "Missing member ~S" key))
  (let ((a (find (semantic-registry-row-identity-v1 row) (semantic-hypergraph-v1-addresses g)
              :key #'semantic-bundle-row-address-v1-row-ref :test #'equal)))
   (resolve-semantic-bundle-row-address-v1 a (getf env :bundle) (getf env :closure) (getf env :generated-set)))))
(defun shg-route (g)
 (let* ((env (semantic-hypergraph-v1-envelope g))
        (payload (semantic-generated-registry-row-v1-payload (first (semantic-hypergraph-v1-routes g)))))
  (loop for key in '(:source-port-ref :target-port-ref) collect
   (shg-resolve g (getf payload key) :port-registry-v1))))
(defun shg-rejects (fn)
 (handler-case (progn (funcall fn) (error "Expected rejection"))
  (error (e) (when (equal (princ-to-string e) "Expected rejection") (error e)) t)))
(defun shg-check (g)
 (shg-validate g)
 ;; Every extension record must agree with its canonical member realization.
 (dolist (collection (semantic-hypergraph-v1-universe g))
  (unless (member (car collection) '(:addresses :relations))
   (dolist (record (cdr collection))
    (let ((row (getf (shg-resolve g (shg-id record)) :row)))
     (unless (equalp (shg-form (car collection) record) (semantic-member-row-v1-semantic-ref row))
      (error "SHG/native record correspondence mismatch"))))))
 (validate-semantic-bundle-persistence-envelope-v1 (semantic-hypergraph-v1-envelope g))
 (let ((subject (shg-find g :addresses (shg-evidence-subject (first (shg-items g :evidence))))))
  (shg-resolve g (shg-addresses-member subject)))
 (dolist (key '(/g :t :e :c :n :instance :op :m :mem :h :binding :proof :r)) (shg-resolve g key))
 (let* ((env (semantic-hypergraph-v1-envelope g))
        (relation (getf (shg-resolve g :r) :row))
        (incidences (remove (semantic-relation-row-v1-relation-row-identity relation)
                      (recursive-semantic-bundle-base-rows-v1 (getf env :bundle) :incidence-registry-v1)
                      :test-not #'equal :key #'semantic-incidence-row-v1-relation-ref)))
  (assert (= 2 (length incidences)))
  (dolist (end (shg-relations-ends (first (shg-items g :relations))))
   (let* ((incidence (find (first end) incidences :key #'semantic-incidence-row-v1-role))
          (port (find (third end) (recursive-semantic-bundle-base-rows-v1 (getf env :bundle) :port-registry-v1)
                  :key #'semantic-port-row-v1-local-port-key)))
    (assert (equal (semantic-incidence-row-v1-participant-ref incidence) (semantic-port-row-v1-port-row-identity port))))))
 (let* ((env (semantic-hypergraph-v1-envelope g))
        (hole (first (recursive-semantic-bundle-base-rows-v1 (getf env :bundle) :hole-registry-v1)))
        (operation (getf (shg-resolve g :op) :row)))
  (assert (equal (semantic-hole-row-v1-owner-ref hole) (semantic-member-row-v1-member-row-identity operation)))
  (assert (equal (semantic-hole-row-v1-required-contract-refs hole) (list (shg-holes-boundary (first (shg-items g :holes))))))
  (shg-resolve g (semantic-hole-row-v1-hole-row-identity hole) :hole-registry-v1))
 (assert (= 2 (length (shg-route g))))
 ;; Existing native query/witness validation binds an explicit handwritten choice.
 ;; This is symbolic graph routing, not an externally verified R001 result.
 (let* ((env (semantic-hypergraph-v1-envelope g))
        (registry (semantic-bundle-generated-root-v1 (getf env :generated-set) :export-registry-v1))
        (port-ref (semantic-port-row-v1-port-row-identity (getf (second (shg-route g)) :row)))
        (selected (find port-ref (semantic-registry-root-v1-rows registry)
                   :key (lambda (row) (getf (semantic-generated-registry-row-v1-payload row) :port-ref)) :test #'equal))
        (query (make-semantic-bundle-route-query-v1 :query-kind :symbolic-navigation
                 :bundle-snapshot-ref (semantic-bundle-closure-v1-bundle-snapshot-ref (getf env :closure))
                 :import-row-ref (semantic-generated-registry-row-v1-row-identity (first (semantic-hypergraph-v1-routes g)))
                 :consumer-ref :op :required-surface-ref :t :required-target-class :graph-object
                 :candidate-export-registry-ref registry :route-profile-ref :hand-shg-symbolic-v1))
        (witness (validate-semantic-bundle-route-witness-v1 query registry
                   (semantic-generated-registry-row-v1-row-identity selected) :hand-selected-export-v1
                   :router-profile-ref :hand-shg-symbolic-v1 :router-epoch-ref 0)))
  (setf (semantic-hypergraph-v1-checks g)
        (list :route-query query :route-witness witness :selection-authority :handwritten
              :structural-checks :passed :behavioral-proof :open :executable :unbound))
  (assert (shg-rejects (lambda () (validate-semantic-bundle-route-witness-v1 query registry :missing :hand-selected-export-v1 :router-profile-ref :hand-shg-symbolic-v1))))
  (assert (shg-rejects (lambda () (validate-semantic-bundle-route-witness-v1 query registry
           (semantic-generated-registry-row-v1-row-identity selected) :hand-selected-export-v1 :router-profile-ref :wrong-profile)))))
 (assert (shg-rejects (lambda () (shg-resolve g :missing))))
 (let ((bad (copy-structure (first (semantic-hypergraph-v1-addresses g)))) (env (semantic-hypergraph-v1-envelope g)))
  (setf (semantic-bundle-row-address-v1-bundle-snapshot-ref bad) "stale")
  (assert (shg-rejects (lambda () (resolve-semantic-bundle-row-address-v1 bad (getf env :bundle) (getf env :closure) (getf env :generated-set))))))
 (let* ((bad (copy-structure g)) (p (copy-structure (first (shg-items g :ports)))))
  (setf (shg-ports-value-type p) :missing
        (semantic-hypergraph-v1-universe bad) (copy-tree (semantic-hypergraph-v1-universe g))
        (cdr (assoc :ports (semantic-hypergraph-v1-universe bad))) (list p))
  (assert (shg-rejects (lambda () (shg-validate bad)))))
 t)
(let* ((args (uiop:command-line-arguments)) (cmd (or (first args) "build"))
       (path (merge-pathnames "working/shg-stack.sexp" (uiop:pathname-directory-pathname *load-truename*))))
 (ensure-directories-exist path)
 (cond
  ((equal cmd "build")
   (let ((g (shg-native-build (shg-fixture))))
    (shg-check g) (working-write path g)
    (let ((r (working-read path))) (shg-check r) (assert (equalp g r)))
    (format t "SHG_BUILD_RELOAD_GREEN collections=15 rules=8 projections=7 invariants=9 addresses=~D symbolic-routes=1 behavioral-admission=OPEN~%" (length (semantic-hypergraph-v1-addresses g)))))
  ((equal cmd "show")
   (let ((g (working-read path)))
    (shg-check g)
    (format t "(semantic-hypergraph ~S (version ~S) (generation ~D) (root ~S)~%  (universe~%" (semantic-hypergraph-v1-id g) (semantic-hypergraph-v1-version g) (semantic-hypergraph-v1-generation g) (semantic-hypergraph-v1-root g))
    (dolist (c (semantic-hypergraph-v1-universe g))
     (unless (eq (car c) :addresses) (format t "    (~S~{~%      ~S~})~%" (car c) (mapcar (lambda (r) (shg-form (car c) r)) (cdr c)))))
    (format t "    (:addresses :native-count ~D))~%  (:transformations ~S)~%  (:projections ~S)~%  (:invariants ~S)~%  (:lifecycle ~S))~%" (length (semantic-hypergraph-v1-addresses g)) (semantic-hypergraph-v1-transformations g) (semantic-hypergraph-v1-projections g) (semantic-hypergraph-v1-invariants g) (semantic-hypergraph-v1-lifecycle g))))
  ((equal cmd "resolve")
   (let* ((g (working-read path)) (key (if (equal (second args) "/G") '/g (intern (string-upcase (second args)) :keyword))))
    (if (eq key :h)
     (let* ((env (semantic-hypergraph-v1-envelope g))
            (hole (first (recursive-semantic-bundle-base-rows-v1 (getf env :bundle) :hole-registry-v1))))
      (format t "~S~%" (shg-resolve g (semantic-hole-row-v1-hole-row-identity hole) :hole-registry-v1)))
     (format t "~S~%" (shg-resolve g key)))))
  ((equal cmd "route")
   (let* ((g (working-read path)) (ends (shg-route g)))
    (shg-check g)
    (format t "(route :status :symbolic :execution :unbound :selection :handwritten~%")
    (loop for role in '(:source :target) for end in ends do
     (format t "  (~S :port ~S :address ~S)~%" role (semantic-port-row-v1-local-port-key (getf end :row)) (getf end :address-ref)))
    (format t "  (:witness ~S))~%" (semantic-bundle-route-witness-v1-witness-identity (getf (semantic-hypergraph-v1-checks g) :route-witness)))))
  (t (error "Usage: build | show | resolve ID | route"))))
