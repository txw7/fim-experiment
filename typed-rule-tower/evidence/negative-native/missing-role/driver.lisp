   (push(list :stage stage :generation(semantic-hypergraph-v1-generation g) :addresses(length members) :dataflows(length flows))records)
   (format t "TOWER_STAGE_GREEN stage=~D addresses=~D dataflows=~D~%" stage(length members)(length flows))
