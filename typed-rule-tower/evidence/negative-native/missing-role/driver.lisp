      :identity(semantic-hypergraph-v1-identity x) :header(semantic-hypergraph-header-v1 x)
      :history(length(shg-objects-v1 x :history))) graphs)
    (dolist(entry(semantic-hypergraph-v1-address-index x))
     (let* ((object(getf entry :object)) (a(getf entry :address)) (id(semantic-bundle-row-address-v1-address-identity a)))
      (let ((resolved(resolve-semantic-hypergraph-address-v1 x id))) (assert(case(shg-object-v1-kind object)(:semantic-hypergraph(eq x resolved))(:collection(eq(shg-objects-v1 x(shg-object-v1-id object))resolved))(otherwise(eq object resolved)))))
      (push (list :graph(semantic-hypergraph-v1-id x) :kind(shg-object-v1-kind object)
        :semantic_id(shg-object-v1-id object) :address id :fields(shg-object-v1-fields object)) members)))
    (setf exports(append exports(semantic-hypergraph-route-exports-v1 x)))
    (dolist(r(shg-objects-v1 x :relations)) (when(eq :association(shg-field-v1 r :type))
     (push(list :graph(semantic-hypergraph-v1-id x) :id(shg-object-v1-id r) :ends(shg-field-v1 r :ends)
       :contract(shg-field-v1 r :contract)) flows)))
    (dolist(child(semantic-hypergraph-v1-children x))(visit child))))(let ((*shg-replaying-v1* t))(tower-frozen-lookups(lambda()(visit g)))))
   ;; Full native resolver rejects previous-generation coordinates.
   (when previous
