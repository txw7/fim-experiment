   (write-char #\{ out) (loop for (k v) on value by #'cddr for first = t then nil do
    (unless first(write-char #\, out)) (tower-json-string(string-downcase(symbol-name k)) out) (write-char #\: out)
    (if (eq k :open_region)(write-string (if v "true" "false") out)(tower-json v out))) (write-char #\} out))
  ((listp value)(write-char #\[ out)(loop for x in value for first = t then nil do (unless first(write-char #\, out))(tower-json x out))(write-char #\] out))
  ((symbolp value)(tower-json-string(string-downcase(symbol-name value)) out)) (t(error "Unsupported JSON value"))))
(defun tower-json-save (path value) (with-open-file(s path :direction :output :if-exists :supersede)(tower-json value s)))
(defun tower-frozen-lookups (thunk &optional (names '(validate-semantic-hypergraph-v1 validate-semantic-bundle-persistence-components-v1)))
 ;; ponytail: cache only this immutable traversal; never survives a stage or revision.
 (let ((originals nil))
  (unwind-protect
   (progn
    (dolist (name names)
     (let ((original(symbol-function name)) (seen(make-hash-table :test #'eq)))
      (push(cons name original)originals)
      (setf(symbol-function name)
       (lambda(&rest args)
        (let* ((context *semantic-boundary-surface-context-v1*) (key(cons context args)) (prior(find-if(lambda(entry)(and(= (length key)(length(car entry)))(every #'eq key(car entry))))(gethash(first args)seen))))
         (if prior(values-list(cdr prior))
          (let ((result(multiple-value-list(apply original args))))(push(cons key result)(gethash(first args)seen))(values-list result))))))))
    (funcall thunk))
   (dolist(entry originals)(setf(symbol-function(car entry))(cdr entry))))))
