                   (:role :target :placement :b :port :input)
                   (:role :observer :placement :c :port :input)) :contract :C :effects (:E) :handler :unbound))
   :children nil))
(defvar *shg-check-count* 0)
(defun shg-test (condition label)
  (unless condition (error "SHG check failed: ~S" label)) (incf *shg-check-count*))
(defun shg-reject (thunk label)
  (shg-test (handler-case (progn (funcall thunk) nil) (error () t)) label))
