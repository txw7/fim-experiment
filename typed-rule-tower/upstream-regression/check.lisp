        (child (copy-tree *shg-fixture-v1*)))
   (setf (getf parent :id) :parent-G (getf parent :connections) nil
         (getf parent :placements) (list (copy-tree (first (getf parent :placements))))
         (getf (first (getf parent :placements)) :child) :inner
         (getf child :id) :child-G)
   (setf (getf parent :children)
         (list (list :id :inner :declaration child :boundary-map
