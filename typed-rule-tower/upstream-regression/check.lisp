   :operations ((:id :work :inputs (:input) :outputs (:output) :preconditions nil :postconditions ((:preserves :T)) :effects (:E) :contract :C))
   :memory ((:id :memory :slots ((:id :slot :type :T :value :uninitialized))))
   :bindings ((:id :binding :provider :test-provider :capability :test-capability :realization :unbound :contract :C))
   :placements ((:id :a :type :unit :parent :none :state :idle :memory :memory :provider :binding :child nil)
