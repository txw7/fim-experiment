    (:direction (setf (getf (first (getf input :port-definitions)) :direction) :out))
    (:transition (setf (getf (first (getf (first (getf input :machines)) :transitions)) :to) :missing))
    (:unsupported (setf (getf input :invented-field) t))
    (:proof (setf (getf input :proof-receipts) '(:accepted))))
   (shg-reject (lambda () (synthesize-semantic-hypergraph-v1 input)) case)))
