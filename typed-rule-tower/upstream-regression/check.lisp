   :contracts ((:id :C :assume nil :guarantee ((:preserve-type :T)) :invariants nil :effects (:E) :dependencies nil))
   :port-definitions ((:id :input :direction :in :value-type :T :effects (:E) :contract :C)
                      (:id :output :direction :out :value-type :T :effects (:E) :contract :C))
   :node-types ((:id :unit :ports (:input :output) :operations (:work) :machine :M :contract :C))
   :machines ((:id :M :states (:idle :ready) :initial :idle :transitions
