diff --git a/lisp/shg_activation_feedback_v1.lisp b/lisp/shg_activation_feedback_v1.lisp
new file mode 100644
index 00000000..a0e993cc
--- /dev/null
+++ b/lisp/shg_activation_feedback_v1.lisp
@@ -0,0 +1,93 @@
+(in-package #:lsip)
+;;; Bounded symbolic coordination profile. No provider dispatch or liveness proof.
+(defun shg-feedback-validate-v1 (intent u ends)
+  (let* ((roles '(:controller :activation :completion :continuation))
+         (ports (getf u :ports))
+         (contract (shg-find-v1 (getf u :contracts) (getf intent :contract)))
+         (machine (shg-find-v1 (getf u :machines) (getf intent :machine)))
+         (work (shg-find-v1 (getf u :relations) (getf intent :work-relation)))
+         (correlation (shg-find-v1 (getf u :types) (getf intent :correlation-schema))))
+    (unless (eq :call (shg-field-v1 work :type)) (error "SHG feedback work must be a typed call"))
+    (unless (and (= 4 (length ends))
+                 (every (lambda (role) (= 1 (count role ends :key (lambda (e) (getf e :role))))) roles))
+      (error "SHG feedback requires exactly four distinct roles"))
+    (loop for role in roles for call-role in '(:caller :argument :result :return) do
+      (unless (equal (getf (find role ends :key (lambda (e) (getf e :role))) :port)
+                     (getf (find call-role (shg-field-v1 work :ends) :key (lambda (e) (getf e :role))) :port))
+        (error "SHG feedback work endpoints differ")))
+    (unless (and (integerp (getf intent :iteration-bound)) (< 0 (getf intent :iteration-bound) 4097))
+      (error "SHG feedback iteration bound invalid"))
+    (unless (equal (shg-field-v1 correlation :schema)
+                   '(:record :graph-generation :natural :input-generation :natural :invocation :string :iteration :natural :attempt :natural))
+      (error "SHG feedback correlation schema invalid"))
+    (unless (and (equal (getf intent :effects) '(:activate :await :publish :terminate))
+                 (subsetp (getf intent :effects) (shg-field-v1 contract :effects) :test #'equal))
+      (error "SHG feedback effect scope invalid"))
+    (labels ((endpoint (role) (find role ends :key (lambda (e) (getf e :role))))
+             (port (role) (shg-find-v1 ports (getf (endpoint role) :port)))
+             (owner (role) (shg-field-v1 (port role) :owner)))
+      (loop for role in roles for direction in '(:out :in :out :in) do
+        (unless (and (eq direction (shg-field-v1 (port role) :direction))
+                     (equal (getf intent :contract) (shg-field-v1 (port role) :contract)))
+          (error "SHG feedback role direction/contract invalid ~S" role)))
+      (unless (and (equal (shg-field-v1 (port :controller) :value-type) (shg-field-v1 (port :activation) :value-type))
+                   (equal (shg-field-v1 (port :completion) :value-type) (shg-field-v1 (port :continuation) :value-type))
+                   (not (equal (shg-field-v1 (port :controller) :value-type) (shg-field-v1 (port :completion) :value-type))))
+        (error "SHG feedback request/completion type mismatch"))
+      (unless (and (equal (owner :controller) (owner :continuation))
+                   (equal (owner :activation) (owner :completion))
+                   (not (equal (owner :controller) (owner :activation))))
+        (error "SHG feedback controller/worker ownership mismatch"))
+      (let* ((occ (shg-find-v1 (getf u :occurrences) (owner :controller)))
+             (node (shg-find-v1 (getf u :node-types) (shg-field-v1 occ :type))))
+        (unless (equal (shg-field-v1 node :machine) (getf intent :machine))
+          (error "SHG feedback controller machine mismatch"))))
+    (unless (and (equal (shg-field-v1 machine :states) '(:ready :waiting :terminated))
+                 (eq (shg-field-v1 machine :initial) :ready))
+      (error "SHG feedback machine state profile invalid"))
+    (let ((transitions (shg-field-v1 machine :transitions))
+          (required '((:ready :waiting :positive-budget) (:waiting :ready :continue)
+                      (:waiting :terminated :stop) (:waiting :terminated :halt) (:waiting :terminated :trap))))
+      (unless (and (= 5 (length transitions))
+                   (every (lambda (shape) (= 1 (count shape transitions :test #'equal
+                          :key (lambda (tr) (list (getf tr :from) (getf tr :to) (getf tr :guard)))))) required))
+        (error "SHG feedback transition profile invalid"))
+      (dolist (tr transitions)
+        (let* ((guard (getf tr :guard)) (predicate (shg-find-v1 (getf u :types) guard)))
+          (unless (equal (shg-field-v1 predicate :schema)
+                        (list :predicate (if (eq guard :positive-budget) '(:controller-state) '(:controller-state :step-completion)) :boolean guard))
+            (error "SHG feedback guard signature invalid")))
+        (let ((expected (case (getf tr :guard)
+                          (:positive-budget '(:activate :await)) (:continue '(:publish))
+                          ((:stop :halt) '(:publish :terminate)) (:trap '(:terminate)))))
+          (unless (and (equal (getf tr :effects) expected)
+                       (eq (getf tr :trigger) (if (eq (getf tr :guard) :positive-budget) :activation-request :step-completion)))
+            (error "SHG feedback transition trigger/effects invalid")))
+        (unless (equal (getf tr :contract) (getf intent :contract))
+          (error "SHG feedback transition contract mismatch"))))
+    t))
+
+(defun shg-call-validate-v1 (intent u ends)
+  (let ((roles '(:caller :argument :result :return)))
+    (unless (and (= 4 (length ends)) (every (lambda (role) (= 1 (count role ends :key (lambda (e) (getf e :role))))) roles))
+      (error "SHG call requires four distinct roles"))
+    (labels ((port (role) (shg-find-v1 (getf u :ports) (getf (find role ends :key (lambda (e) (getf e :role))) :port))))
+      (loop for role in roles for direction in '(:out :in :out :in) do
+        (unless (eq direction (shg-field-v1 (port role) :direction)) (error "SHG call port direction invalid")))
+      (unless (and (equal (shg-field-v1 (port :caller) :value-type) (shg-field-v1 (port :argument) :value-type))
+                   (equal (shg-field-v1 (port :result) :value-type) (shg-field-v1 (port :return) :value-type))
+                   (equal (shg-field-v1 (port :caller) :owner) (shg-field-v1 (port :return) :owner))
+                   (equal (shg-field-v1 (port :argument) :owner) (shg-field-v1 (port :result) :owner))
+                   (not (equal (shg-field-v1 (port :caller) :owner) (shg-field-v1 (port :argument) :owner))))
+        (error "SHG call typed argument/result or ownership mismatch"))
+      (let* ((occ (shg-find-v1 (getf u :occurrences) (shg-field-v1 (port :argument) :owner)))
+             (node (shg-find-v1 (getf u :node-types) (shg-field-v1 occ :type)))
+             (callee (shg-find-v1 (getf u :operations) (getf intent :callee-operation)))
+             (contract (shg-find-v1 (getf u :contracts) (getf intent :contract))))
+        (unless (and (member (getf intent :callee-operation) (shg-field-v1 node :operations) :test #'equal)
+                     (subsetp (getf intent :effects) (shg-field-v1 callee :effects) :test #'equal)
+                     (subsetp (getf intent :effects) (shg-field-v1 contract :effects) :test #'equal)
+                     (equal (getf intent :contract) (shg-field-v1 callee :contract))
+                     (member (shg-field-v1 (port :argument) :definition) (getf (shg-field-v1 callee :boundary) :inputs) :test #'equal)
+                     (member (shg-field-v1 (port :result) :definition) (getf (shg-field-v1 callee :boundary) :outputs) :test #'equal))
+          (error "SHG call callee/effect scope invalid"))))) t)
