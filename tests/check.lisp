(require :asdf)
(push :shg-library *features*)
(load (merge-pathnames "../shg-stack.lisp" (uiop:pathname-directory-pathname *load-truename*)))
(in-package :lsip)
(defun test-copy (x)
 (cond ((consp x) (cons (test-copy (car x)) (test-copy (cdr x))))
       ((typep x 'structure-object) (let ((c (copy-structure x))) (dolist(s (sb-mop:class-slots (class-of x))) (setf (slot-value c (sb-mop:slot-definition-name s)) (test-copy (slot-value x (sb-mop:slot-definition-name s))))) c))
       (t x)))
(defvar *checks* 0)
(defun reject (name category fn)
 (assert (shg-rejects fn category)) (incf *checks*) (format t "PASS ~A (~A)~%" name category))
(let ((g (shg-native-build (shg-fixture))))
 (flet ((mutation (name category change)
         (let ((b (test-copy g))) (funcall change b) (reject name category (lambda()(shg-check b))))))
  (mutation :lifecycle :lifecycle (lambda(b)(setf (semantic-hypergraph-v1-lifecycle b) :admitted)))
  (mutation :missing-effect :effect (lambda(b)(setf (shg-relations-effects (first(shg-items b :relations))) '(:missing))))
  (mutation :proof-alias :correspondence (lambda(b)(setf (shg-addresses-member (shg-find b :addresses :op-address)) :t)))
  (mutation :root :missing (lambda(b)(setf (semantic-hypergraph-v1-root b) :wrong)))
  (mutation :rules :correspondence (lambda(b)(setf (semantic-hypergraph-v1-transformations b) nil)))
  (mutation :relation-map :relation (lambda(b)(setf (semantic-hypergraph-v1-relation-map b) nil)))
  (mutation :proven-with-forged-evidence :proof (lambda(b)(let((e (first(shg-items b :evidence))))(setf (shg-evidence-status e) :proven (shg-evidence-evidence e) '(:fake)))))
  (mutation :proof-native :proof (lambda(b)(setf (cdr(first(semantic-hypergraph-v1-proof-subjects b))) (shg-address-for b :member-registry-v1 (shg-member b :t)))))
  (mutation :reverse-route :route (lambda(b)(let ((p (semantic-generated-registry-row-v1-payload (first(semantic-hypergraph-v1-routes b))))) (rotatef (getf p :source-port-ref) (getf p :target-port-ref)))))
  (mutation :state :state (lambda(b)(setf (shg-occurrences-state(first(shg-items b :occurrences))) :bogus)))
  (mutation :cycle :containment (lambda(b)(setf (shg-occurrences-parent(first(shg-items b :occurrences))) :instance)))
  (mutation :transition-effect :effect (lambda(b)(setf (getf (first(shg-machines-transitions(first(shg-items b :machines)))) :effects) '(:bogus))))
  (mutation :body-primitive :unsupported-profile (lambda(b)(setf (shg-operations-body(first(shg-items b :operations))) :primitive (shg-occurrences-body(first(shg-items b :occurrences))) :primitive)))
  (mutation :initialized-memory :unsupported-profile (lambda(b)(setf (getf(first(shg-memory-slots(first(shg-items b :memory)))) :value) 7)))
  (dolist (slot '(row-ref bundle-occurrence-path bundle-snapshot-ref registry-kind lineage-ref address-identity facet-ref))
   (mutation slot :address (lambda(b)(setf (slot-value(first(semantic-hypergraph-v1-addresses b)) slot) :forged)))))
 (let ((bad (shg-fixture)))
  (push (shg-record :types :id :other :schema '(:nominal :other)) (cdr(assoc :types(semantic-hypergraph-v1-universe bad))))
  (setf (shg-ports-value-type(shg-find bad :ports :p-in)) :other)
  (reject :incompatible-type :type (lambda()(shg-native-build bad))))
 (reject :missing-member :missing (lambda()(shg-resolve g :bogus)))
 ;; Second fixture changes all semantic identifiers and adds a second edge/third port.
 (let* ((b (shg-fixture))
        (ids (append (list :g '/g) (loop for c in (semantic-hypergraph-v1-universe b) append (mapcar #'shg-id(cdr c)))))
        (mapping (mapcar(lambda(id)(cons id (intern(format nil "B-~A" id) :keyword))) ids)))
  (labels ((rename(x)
   (cond ((assoc x mapping) (cdr(assoc x mapping)))
    ((consp x)(cons(rename(car x))(rename(cdr x))))
    ((typep x 'structure-object)(let((c(copy-structure x)))(dolist(s(sb-mop:class-slots(class-of x)))(setf(slot-value c(sb-mop:slot-definition-name s))(rename(slot-value x(sb-mop:slot-definition-name s)))))c)) (t x))))
   ;; Rename universe and identity fields, retain rule/predicate vocabulary.
   (setf (semantic-hypergraph-v1-universe b) (rename(semantic-hypergraph-v1-universe b))
         (semantic-hypergraph-v1-id b) :b-g (semantic-hypergraph-v1-root b) :b-/g))
  (push (shg-record :ports :id :b-extra :owner :b-instance :direction :out :value-type :b-t :effects '(:b-e) :contract :b-c) (cdr(assoc :ports(semantic-hypergraph-v1-universe b))))
  (push :b-extra (shg-node-types-ports(shg-find b :node-types :b-n)))
  (push :b-extra (getf(shg-operations-boundary(shg-find b :operations :b-op)) :outputs))
  (push (shg-record :relations :id :b-r2 :type :dataflow :ends '((:source :b-instance :b-extra)(:target :b-instance :b-p-in)) :contract :b-c :effects '(:b-e) :handler :unbound) (cdr(assoc :relations(semantic-hypergraph-v1-universe b))))
  (setf (shg-types-schema(shg-find b :types :b-t)) '(:nominal :second-domain))
  (setf b(shg-native-build b))
  (assert (= 2(length(semantic-hypergraph-v1-routes b))))
  (assert (not(equal (getf(shg-resolve b :b-r) :row-ref)(getf(shg-resolve b :b-r2) :row-ref))))
  (let ((path (merge-pathnames "working/second.sexp" cl-user::*shg-directory*)))
   (working-write path b) (let((r(working-read path)))(shg-check r)(assert(equalp b r))))
  (incf *checks*) (format t "PASS second-fixture (two distinct relations)~%"))
 (dolist (query (list (shg-describe g) (shg-neighbors g :p-out) (shg-obligations g)
   (semantic-bundle-relation-projection-v1 (shg-view g) '(:dataflow)))) (assert query))
 (incf *checks*) (format t "PASS compact-queries~%"))
(format t "SHG_TEST_GREEN checks=~D~%" *checks*)
