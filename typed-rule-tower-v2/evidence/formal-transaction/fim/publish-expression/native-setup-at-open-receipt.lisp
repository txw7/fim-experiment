;;; Native receipt for an OPEN implementation correspondence obligation.
;;; External Kani checks are retained evidence, not fabricated native theorems.
(require :asdf)
(defparameter *native-root* #p"/home/user0/ORCHESTRATION/worktrees/goggles-vm-feedback-47fe6800/")
(asdf:initialize-source-registry `(:source-registry (:directory ,*native-root*) :inherit-configuration))
(setf *compile-verbose* nil *compile-print* nil)
(asdf:load-system "lsip-shg-encapsulator-v1")
;;; Load original formal record owners without bootstrapping another graph world.
;;; Evaluate only the three carrier DEFSTRUCT forms from their pinned owner.
(let ((*read-eval* nil) (*package* (find-package :lsip)))
  (with-open-file (in (merge-pathnames "lisp/formal_bridge.lisp" *native-root*))
    (loop for form = (read in nil :eof) until (eq form :eof) do
      (when (and (consp form) (eq (first form) 'defstruct)
                 (member (second form) '(lsip::formal-obligation lsip::formal-run lsip::formal-evidence)))
        (eval form)))))
(load (merge-pathnames "lisp/compiler_ir.lisp" *native-root*))
(load (merge-pathnames "lisp/formal_claim_state_v1.lisp" *native-root*))
(load (merge-pathnames "lisp/formal_methods_fabric_v1.lisp" *native-root*))
(in-package #:lsip)
(in-package #:lsip)
(shg-install-constitutions-v1)
(defun fim-validate-native-subject-v1 (coordinates kind)
(let* ((artifact (with-open-file (in (getf coordinates :artifact))
                   (let ((*read-eval* nil)) (read in))))
       (graphs (labels ((walk (g) (cons g (mapcan #'walk (semantic-hypergraph-v1-children g))))) (walk artifact)))
       (owner (find-if (lambda (g) (find (getf coordinates :subject)
                                     (semantic-hypergraph-v1-address-index g)
                                     :test #'equal :key (lambda (e) (semantic-bundle-row-address-v1-address-identity (getf e :address))))) graphs)))
  (unless owner (error "FIM native subject not found"))
  (let ((object (resolve-semantic-hypergraph-address-v1 owner (getf coordinates :subject))))
    (unless (and (eq (shg-object-v1-kind object) kind)
                 (equal (getf (semantic-hypergraph-header-v1 owner) :snapshot-ref)
                        (getf coordinates :snapshot)))
      (error "FIM native subject/snapshot correspondence mismatch"))))
  t)
