(require :asdf)
(asdf:initialize-source-registry '(:source-registry (:directory "/home/user0/ORCHESTRATION/worktrees/goggles-semantic-lift-v1/") :inherit-configuration))
(setf *compile-verbose* nil *compile-print* nil)
(asdf:load-system "lsip-graph-identity")
(load "/home/user0/ORCHESTRATION/worktrees/goggles-semantic-lift-v1/lisp/semantic_address_rewrite_v1.lisp")
(in-package #:lsip)
(let* ((args (uiop:command-line-arguments))
       (input (with-open-file (s (first args)) (let ((*read-eval* nil)) (read s)))))
  (with-open-file (out (second args) :direction :output :if-exists :supersede)
    (dolist (candidate input)
      (let* ((source (getf candidate :source)) (rows (getf candidate :objects))
             (relations (getf candidate :relations)) (nodes nil) (regions nil) (holes nil) (interiors nil)
             (root (make-semantic-region-v1 :semantic-ref "source-root" :region-kind :generic-region :surface-ref source :opacity :opaque)))
        (dolist (row rows)
          (unless (equal "network" (getf row :kind))
            (push (make-semantic-node-v1 :semantic-ref (getf row :id) :node-kind :opaque-semantic-object
                    :input-surface-ref (list source (getf row :anchors))
                    :output-surface-ref (list :proposed-kind (getf row :kind) :proposed-type (getf row :type) :claimed-license (getf row :license))) nodes)))
        (labels ((network (id stack)
                   (when (member id stack :test #'equal) (error "Native candidate containment cycle"))
                   (or (find id regions :key #'semantic-region-v1-semantic-ref :test #'equal)
                     (let* ((row (find id rows :key (lambda (x) (getf x :id)) :test #'equal))
                            (members (getf row :members))
                            (seed (make-semantic-region-v1 :semantic-ref id :region-kind :generic-region :surface-ref (list source (getf row :anchors))))
                            (child-regions (loop for child in rows when (and (member (getf child :id) members :test #'equal) (equal "network" (getf child :kind))) collect (network (getf child :id) (cons id stack))))
                            (body (make-partial-recursive-semantic-hypergraph-v1 :graph-kind :seed
                                    :resolved-regions (cons seed child-regions) :root-region-ref seed
                                    :resolved-nodes (remove-if-not (lambda (n) (member (semantic-node-v1-semantic-ref n) members :test #'equal)) nodes)
                                    :incidence-holes (loop for rel in relations when (member (getf rel :id) members :test #'equal) collect
                                      (make-incidence-hole-v1 :semantic-ref (getf rel :id) :owning-graph-ref (format nil "~A/~A/~A" source (getf candidate :id) id) :participant-domain (getf rel :ends) :allowed-kinds '(:member) :formal-constraints (list :unregistered-meaning (getf rel :constitution)) :provenance-ref source :address-ref (getf rel :id)))))
                            (region (make-semantic-region-v1 :semantic-ref id :region-kind :generic-region :surface-ref (list source (getf row :anchors)) :refinement-ref body :opacity :expanded))
                            (contracted (contract-region-v1 region)) (expanded (expand-region-v1 contracted body)))
                       (assert (equal (semantic-region-v1-refinement-ref expanded) body))
                       (push (list :network id :interior (partial-recursive-semantic-hypergraph-v1-form body) :contracted (semantic-region-v1-form contracted) :expanded (semantic-region-v1-form expanded)) interiors)
                       (push region regions) region))))
          (dolist (row rows) (when (equal "network" (getf row :kind)) (network (getf row :id) nil))))
        (labels ((participant (id)
                   (or (let ((n (find id nodes :key #'semantic-node-v1-semantic-ref :test #'equal))) (and n (semantic-node-v1-node-identity n)))
                       (let ((r (find id regions :key #'semantic-region-v1-semantic-ref :test #'equal))) (and r (semantic-region-v1-region-identity r)))
                       (list :unresolved-relation-ref id))))
          (dolist (rel relations)
            (push (make-incidence-hole-v1 :semantic-ref (getf rel :id) :owning-graph-ref (format nil "~A/~A/source-root" source (getf candidate :id))
                    :participant-domain (mapcar (lambda (e) (list :role (getf e :role) :target (participant (getf e :target)))) (getf rel :ends))
                    :formal-constraints (list :meaning-not-admitted (getf rel :constitution) :family (getf rel :family))
                    :allowed-kinds '(:member) :provenance-ref source :address-ref (getf rel :id)) holes)))
        (let ((graph (make-partial-recursive-semantic-hypergraph-v1 :graph-kind :seed :resolved-regions (cons root regions) :resolved-nodes nodes :incidence-holes holes :root-region-ref root :provenance-ref source)))
          (validate-partial-recursive-semantic-hypergraph-v1 graph)
          (write (list :candidate (getf candidate :id) :semantic-admission :blocked-missing-laws
                  :partial-graph (partial-recursive-semantic-hypergraph-v1-form graph)
                  :nodes (mapcar #'semantic-node-v1-form nodes) :regions (mapcar #'semantic-region-v1-form regions)
                  :holes (mapcar (lambda (h) (list :identity (semantic-hypergraph-hole-v1-hole-identity h) :ref (semantic-hypergraph-hole-v1-semantic-ref h) :participants (semantic-hypergraph-hole-v1-participant-domain h) :constraints (semantic-hypergraph-hole-v1-formal-constraints h))) holes)
                  :contract-expand-witnesses interiors) :stream out :pretty t)
          (terpri out))))))
(format t "NATIVE_PARTIAL_CONSTRUCTION_GREEN~%")
