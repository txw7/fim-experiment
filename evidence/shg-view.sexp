(semantic-hypergraph :G (version (0 1)) (generation 0) (root /G)
  (universe
    (:TYPES
      (:TYPES :ID :T :SCHEMA (:NOMINAL :MESSAGE-V1) :REFINEMENTS NIL))
    (:EFFECTS
      (:EFFECTS :ID :E :INPUT :T :OUTPUT :T :CONSTRAINTS (:DECLARED-ONLY)))
    (:CONTRACTS
      (:CONTRACTS :ID :C :ASSUME (:TYPED-INPUT) :GUARANTEE (:TYPED-OUTPUT)
       :INVARIANTS (:BOUNDARY-PRESERVED) :EFFECTS (:E) :DEPENDENCIES NIL))
    (:PORTS
      (:PORTS :ID :P-OUT :OWNER :INSTANCE :DIRECTION :OUT :VALUE-TYPE :T
       :EFFECTS (:E) :CONTRACT :C)
      (:PORTS :ID :P-IN :OWNER :INSTANCE :DIRECTION :IN :VALUE-TYPE :T :EFFECTS
       (:E) :CONTRACT :C))
    (:NODE-TYPES
      (:NODE-TYPES :ID :N :PORTS (:P-IN :P-OUT) :OPERATIONS (:OP) :MACHINE :M
       :CONTRACT :C))
    (:OCCURRENCES
      (:OCCURRENCES :ID :INSTANCE :TYPE :N :PARENT :NONE :GENERATION 0 :STATE
       :IDLE :MEMORY :MEM :PROVIDER :BINDING :BODY :H))
    (:RELATIONS
      (:RELATIONS :ID :R :TYPE :DATAFLOW :ENDS
       ((:SOURCE :INSTANCE :P-OUT) (:TARGET :INSTANCE :P-IN)) :CONTRACT :C
       :EFFECTS (:E) :HANDLER :UNBOUND))
    (:MACHINES
      (:MACHINES :ID :M :STATES (:IDLE :DONE) :INITIAL :IDLE :TRANSITIONS
       ((:ID :ADVANCE :FROM :IDLE :TO :DONE :TRIGGER :MESSAGE-V1 :GUARD
         :TYPED-INPUT :OPERATION :OP :EFFECTS (:E) :CONTRACT :C))))
    (:OPERATIONS
      (:OPERATIONS :ID :OP :BOUNDARY (:INPUTS (:P-IN) :OUTPUTS (:P-OUT))
       :PRECONDITIONS (:TYPED-INPUT) :POSTCONDITIONS (:TYPED-OUTPUT) :EFFECTS
       (:E) :BODY :H :CONTRACT :C))
    (:MEMORY
      (:MEMORY :ID :MEM :SLOTS ((:ID :SLOT :TYPE :T :VALUE :UNINITIALIZED))))
    (:HOLES
      (:HOLES :ID :H :BOUNDARY :C :OBLIGATIONS (:PROOF)))
    (:BINDINGS
      (:BINDINGS :ID :BINDING :PROVIDER :UNBOUND :CAPABILITY :UNBOUND
       :REALIZATION :UNBOUND :CONTRACT :C))
    (:EVIDENCE
      (:EVIDENCE :ID :PROOF :KIND :OBLIGATION :SUBJECT :OP-ADDRESS :GENERATION
       0 :DIGEST NIL :CLAIM :IMPLEMENTATION-REFINES-CONTRACT :METHOD :UNBOUND
       :STATUS :OPEN :EVIDENCE NIL))
    (:HISTORY)
    (:addresses :native-count 45))
  (:transformations ((:INSTANTIATE :REQUIRES
                      (:VALID-NODE-TYPE :LAWFUL-PLACEMENT) :PRODUCES
                      (:DISTINCT-OCCURRENCE :DECLARED-PORTS))
                     (:OPEN-BODY :REQUIRES (:DECLARED-OPERATION-BOUNDARY)
                      :PRODUCES (:TYPED-HOLE :REFINEMENT-OBLIGATIONS))
                     (:NEST :REQUIRES (:COMPATIBLE-CHILD-BOUNDARY) :PRODUCES
                      (:PARENT-CHILD-CORRESPONDENCE))
                     (:RELATE :REQUIRES (:VALID-RELATION-CONSTITUTION)
                      :PRODUCES (:RELATION :ROLE-BEARING-INCIDENCES))
                     (:DERIVE-DEPENDENCY :REQUIRES
                      (:REFERENCED-CONTRACT-OR-TYPE) :PRODUCES
                      (:DEPENDENCY-RELATION))
                     (:REFINE :REQUIRES
                      (:BOUNDARY-PRESERVATION :STATE-EFFECT-PRESERVATION
                       :BEHAVIORAL-REFINEMENT)
                      :PRODUCES (:SUCCESSOR-BODY :PROOF-OBLIGATIONS))
                     (:REVISE :REQUIRES
                      (:IDENTIFIED-GENERATION :EXPLICIT-GRAPH-DELTA) :PRODUCES
                      (:SUCCESSOR-GENERATION :REVISION-RECORD))
                     (:ADMIT :REQUIRES
                      (:VERIFIED-OBLIGATIONS :VALID-CONTRACTS
                       :CONSISTENT-ADDRESSES)
                      :PRODUCES (:ADMITTED-GENERATION))))
  (:projections ((:STRUCTURAL :OCCURRENCES :PORTS :RELATIONS :ADDRESSES)
                 (:OPERATIONAL :MACHINES :OPERATIONS :EFFECTS :MEMORY)
                 (:DEPENDENCY :CONTRACTS :DEPENDENCY-RELATIONS)
                 (:VERIFICATION :INVARIANTS :OBLIGATIONS :EVIDENCE)
                 (:SYNTHESIS :OPERATIONS :MACHINES :BINDINGS :TARGET
                  :STACK-SYNTH)
                 (:ROUTING :BINDINGS :ADDRESSES :CONTRACTS :TARGET
                  :ROUTE-REGISTRY)
                 (:EVOLUTION :TRANSFORMATIONS :REVISIONS :HISTORY)))
  (:invariants (:UNIQUE-OCCURRENCE-IDENTITIES :WELL-TYPED-PORT-INCIDENCES
                :WELL-FORMED-ROLE-ASSIGNMENTS :VALID-PARENT-CHILD-BOUNDARIES
                :STABLE-GENERATION-ADDRESSING :DECLARED-EFFECTS-ONLY
                :TRANSITION-CONTRACT-CONSISTENCY
                :REFINEMENT-PRESERVES-EXTERNAL-CONTRACT
                :ADMISSION-REQUIRES-VERIFICATION))
  (:lifecycle :INSTANTIATED))
