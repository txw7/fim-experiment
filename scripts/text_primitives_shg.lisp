(require :asdf)
(push :shg-library *features*)
(load (merge-pathnames "../shg-stack.lisp" (uiop:pathname-directory-pathname *load-truename*)))
(in-package :lsip)
(defun text-primitives-graph ()
 (let ((g (shg-fixture))
       (pins (working-read (merge-pathnames "working/text-primitives/artifact-pins.sexp" cl-user::*shg-directory*)))
       (stages '(:source :tokenize :stem :ngrams :cooccurrence :ppmi :tfidf :zipf)))
  (setf (semantic-hypergraph-v1-id g) :text-idiom
        (semantic-hypergraph-v1-root g) :text-idiom-root
        (semantic-hypergraph-v1-universe g) (mapcar (lambda (s) (list (car s))) *shg-shapes*))
  (labels ((id (stage suffix) (intern (format nil "~A-~A" stage suffix) :keyword))
           (add (kind &rest fields) (push (apply #'shg-record kind fields) (cdr (assoc kind (semantic-hypergraph-v1-universe g))))))
   (add :types :id :artifact-ref :schema '(:nominal :source-pinned-artifact-reference) :refinements nil)
   (dolist (stage stages) (add :effects :id (id stage "EFFECT") :input :artifact-ref :output :artifact-ref :constraints '(:source-pin-retained)))
   (let ((effects (mapcar (lambda (stage) (id stage "EFFECT")) stages)))
    (add :contracts :id :lexical-contract :assume '(:source-pinned) :guarantee '(:lexical-observation-only) :invariants '(:no-inferred-identity :no-entailment-admission) :effects effects :dependencies nil)
    (dolist (stage stages)
     (let ((occ (id stage "INSTANCE")) (nt (id stage "TYPE")) (op (id stage "OP")) (in (id stage "IN")) (out (id stage "OUT")) (hole (id stage "HOLE")) (proof (id stage "OBLIGATION")) (address (id stage "ADDRESS")) (machine (id stage "MACHINE")) (memory (id stage "MEMORY")) (binding (id stage "BINDING")))
      (add :node-types :id nt :ports (list in out) :operations (list op) :machine machine :contract :lexical-contract)
      (add :occurrences :id occ :type nt :parent :none :generation 0 :state :idle :memory memory :provider binding :body hole)
      (add :ports :id in :owner occ :direction :in :value-type :artifact-ref :effects (list (id stage "EFFECT")) :contract :lexical-contract)
      (add :ports :id out :owner occ :direction :out :value-type :artifact-ref :effects (list (id stage "EFFECT")) :contract :lexical-contract)
      (add :operations :id op :boundary (list :inputs (list in) :outputs (list out)) :preconditions (list :source-pinned stage :artifacts (cdr (assoc stage pins))) :postconditions '(:lexical-observation-only) :effects (list (id stage "EFFECT")) :body hole :contract :lexical-contract)
      (add :machines :id machine :states '(:idle) :initial :idle :transitions nil)
      (add :memory :id memory :slots nil)
      (add :holes :id hole :boundary :lexical-contract :obligations (list proof))
      (add :bindings :id binding :provider :unbound :capability :unbound :realization :unbound :contract :lexical-contract)
      (add :addresses :id address :root :text-idiom :generation 0 :path '(:text-idiom) :member op)
      (add :evidence :id proof :kind :obligation :subject address :generation 0 :claim :implementation-matches-source-pinned-observation :method :unbound :status :unknown :evidence nil)))
    (dolist (pair '((:source :tokenize) (:tokenize :stem) (:tokenize :ngrams) (:tokenize :cooccurrence) (:cooccurrence :ppmi) (:tokenize :tfidf) (:tokenize :zipf)))
     (destructuring-bind (from to) pair
      (add :relations :id (intern (format nil "~A-TO-~A" from to) :keyword) :type :dataflow
       :ends (list (list :source (id from "INSTANCE") (id from "OUT")) (list :target (id to "INSTANCE") (id to "IN"))) :contract :lexical-contract :effects nil :handler :unbound))))
   (shg-validate g) g)))
(let* ((path (merge-pathnames "working/text-primitives/shg.sexp" cl-user::*shg-directory*))
       (g (progn (format t "SHG_NATIVE_BUILD_BEGIN~%") (finish-output) (shg-native-build (text-primitives-graph)))))
 (ensure-directories-exist path) (working-write path g)
 (let ((restored (working-read path))) (shg-check restored) (assert (equalp g restored)))
 (assert (= 7 (length (semantic-hypergraph-v1-routes g))))
 (working-write (merge-pathnames "working/text-primitives/native-description.sexp" cl-user::*shg-directory*) (shg-describe g))
 (working-write (merge-pathnames "working/text-primitives/native-operation-addresses.sexp" cl-user::*shg-directory*)
  (loop for op in (shg-items g :operations) collect (list :operation (shg-id op) :address (shg-resolve g (shg-id op)))))
 (format t "TEXT_PRIMITIVES_SHG_GREEN operations=8 routes=7 addresses=~D execution=UNBOUND~%" (length (semantic-hypergraph-v1-addresses g))))
