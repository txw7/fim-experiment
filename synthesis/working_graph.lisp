(require :asdf)
(defparameter *mc-root* (uiop:ensure-directory-pathname (or (uiop:getenv "SHG_GOGGLES_ROOT") (merge-pathnames "deps/literate-goggles/" (uiop:pathname-directory-pathname *load-truename*)))))
(asdf:initialize-source-registry `(:source-registry (:directory ,*mc-root*) :inherit-configuration))
(setf *compile-verbose* nil *compile-print* nil)
(asdf:load-system "lsip-goggles-reactor-minimal-v1")
(asdf:load-system "lsip-scaffold-persistence")
(let ((*package* (find-package :lsip)) (*read-eval* nil))
 (with-open-file (stream (merge-pathnames "lisp/synthesis_realization_provider_v1.lisp" *mc-root*))
  (loop for form = (read stream nil :end) until (eq form :end) do
   (when (and (consp form) (eq (first form) 'defun) (string= (symbol-name (second form)) "REALIZATION-V1-PROPER-LIST-P")) (eval form) (return)))))
(dolist (name '("semantic_a002_saturation_bridge_v1" "semantic_transport_v1" "semantic_relation_enumeration_v1" "semantic_relation_goal_planning_v1" "recursive_semantic_scaffold_v1"))
 (load (merge-pathnames (format nil "lisp/~A.lisp" name) *mc-root*)))
(in-package #:lsip)

(defun working-read (path)
 (let ((*read-eval* nil) (*package* (find-package :lsip)))
  (with-open-file (s path) (let ((object (read s)))
   (unless (eq :end (read s nil :end)) (error "Trailing graph data")) object))))
(defun working-shared (object)
 ;; SBCL structure slots preserve original native record classes and fields.
 (let ((table (make-hash-table :test #'equalp)))
  (labels ((share (x)
    (let ((copy
      (cond ((consp x) (cons (share (car x)) (share (cdr x))))
            ((typep x 'structure-object)
             (let ((c (copy-structure x)))
              (dolist (slot (sb-mop:class-slots (class-of c)))
               (let ((name (sb-mop:slot-definition-name slot)))
                (setf (slot-value c name) (share (slot-value x name))))) c))
            (t x))))
     (if (or (consp copy) (stringp copy) (typep copy 'structure-object))
      (multiple-value-bind (prior found) (gethash copy table)
       (if found prior (setf (gethash copy table) copy))) copy))))
   (share object))))
(defun working-write (path object)
 (with-open-file (s path :direction :output :if-exists :supersede :if-does-not-exist :create)
  (with-standard-io-syntax
   (let ((*package* (find-package :lsip)) (*print-circle* t) (*print-pretty* nil))
    (write (working-shared object) :stream s :readably t) (terpri s)))))
(defun working-check (object)
 (etypecase object
  (minimum-core-scaffold-v1 (validate-minimum-core-scaffold-v1 object))
  (cons (validate-semantic-bundle-persistence-envelope-v1 object))))
(let* ((args (uiop:command-line-arguments)) (command (first args)))
 (cond
  ((equal command "pack")
   (let ((object (working-read (second args))))
    (working-check object) (working-write (third args) object)
    (let ((restored (working-read (third args))))
     (working-check restored)
     (unless (equalp object restored) (error "Persistence round trip changed native objects")))
    (format t "PACK_RELOAD_GREEN~%")))
  ((equal command "synth")
   (let ((result (derive-minimum-core-scaffold-v1 (working-read (second args)))))
    (working-check result) (working-write (third args) result)
    (working-check (working-read (third args))) (format t "SYNTH_RELOAD_GREEN ~A~%" (minimum-core-scaffold-v1-identity result))))
  ((equal command "check") (working-check (working-read (second args))) (format t "CHECK_GREEN~%"))
  ((equal command "resolve")
   (let* ((graph (working-read (second args)))
          (id (third args))
          (address (or (find id (minimum-core-scaffold-v1-addresses graph) :test #'equal :key #'semantic-bundle-row-address-v1-address-identity) (error "Unknown exact address"))))
    (working-write (fourth args) (resolve-minimum-core-address-v1 graph address))
    (format t "RESOLVE_GREEN ~A~%" id)))
  ((equal command "index")
   (let ((graph (working-read (second args))))
    (working-check graph)
    (dolist (a (minimum-core-scaffold-v1-addresses graph))
     (format t "~A ~S~%" (semantic-bundle-row-address-v1-address-identity a) (semantic-scope-path-v1-segment-tokens (semantic-bundle-row-address-v1-bundle-occurrence-path a))))))
  (t (error "Usage: pack INPUT OUTPUT | synth DECLARATION OUTPUT | check GRAPH | index GRAPH | resolve GRAPH ADDRESS OUTPUT"))))
